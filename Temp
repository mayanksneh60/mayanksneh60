import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
from torchvision import transforms, models
from torch.utils.data import Dataset, DataLoader
from PIL import Image
import pandas as pd
import os
from tqdm import tqdm

# ----------------------------
# MODEL DEFINITION
# ----------------------------
class UIStateDetector(nn.Module):
    def __init__(self, num_classes=5, model_type="efficientnet_b2"):
        super().__init__()

        if model_type == "efficientnet_b2":
            backbone = models.efficientnet_b2(weights="IMAGENET1K_V1")
            self.visual_encoder = backbone.features
            visual_out_dim = 1408
        elif model_type == "vit_s":
            backbone = models.vit_b_16(weights="IMAGENET1K_V1")
            self.visual_encoder = nn.Sequential(*list(backbone.children())[:-1])
            visual_out_dim = 768
        else:
            raise ValueError("Unknown model_type")

        self.coord_encoder = nn.Sequential(
            nn.Linear(4, 64),
            nn.ReLU(),
            nn.Linear(64, 128),
            nn.ReLU(),
        )

        self.classifier = nn.Sequential(
            nn.Linear(visual_out_dim + 128, 512),
            nn.ReLU(),
            nn.Dropout(0.3),
            nn.Linear(512, num_classes),
        )

        self.global_pool = nn.AdaptiveAvgPool2d((1, 1))

    def forward(self, image, coords):
        vision_feat = self.visual_encoder(image)            # [B, C, H', W']
        vision_feat = self.global_pool(vision_feat)          # [B, C, 1, 1]
        vision_feat = vision_feat.view(vision_feat.size(0), -1)  # [B, C]
        coord_feat = self.coord_encoder(coords)              # [B, 128]
        fused = torch.cat([vision_feat, coord_feat], dim=-1) # [B, C+128]
        logits = self.classifier(fused)                      # [B, num_classes]
        return logits


# ----------------------------
# DATASET DEFINITION
# ----------------------------
class UIScreenshotDataset(Dataset):
    def __init__(self, csv_path, img_dir, label2id, transform=None):
        self.data = pd.read_csv(csv_path)
        self.img_dir = img_dir
        self.transform = transform
        self.label2id = label2id

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        row = self.data.iloc[idx]
        img_path = os.path.join(self.img_dir, row["image_path"])
        image = Image.open(img_path).convert("RGB")

        # Coordinates and normalization
        x1, y1, x2, y2 = row["x1"], row["y1"], row["x2"], row["y2"]
        screen_w, screen_h = row["screen_w"], row["screen_h"]
        coords = torch.tensor([
            x1 / screen_w,
            y1 / screen_h,
            x2 / screen_w,
            y2 / screen_h
        ], dtype=torch.float32)

        label = torch.tensor(self.label2id[row["label"]], dtype=torch.long)

        if self.transform:
            image = self.transform(image)

        return image, coords, label


# ----------------------------
# TRAINING SCRIPT
# ----------------------------
def train_model(csv_train, img_dir, label_list, num_epochs=10, batch_size=8, lr=2e-4, model_type="efficientnet_b2"):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Using device: {device}")

    label2id = {label: i for i, label in enumerate(label_list)}

    transform = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.1),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406],
                             [0.229, 0.224, 0.225]),
    ])

    dataset = UIScreenshotDataset(csv_train, img_dir, label2id, transform)
    loader = DataLoader(dataset, batch_size=batch_size, shuffle=True, num_workers=4)

    model = UIStateDetector(num_classes=len(label_list), model_type=model_type).to(device)
    optimizer = optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)

    for epoch in range(num_epochs):
        model.train()
        total_loss, correct, total = 0, 0, 0

        for images, coords, labels in tqdm(loader, desc=f"Epoch {epoch+1}/{num_epochs}"):
            images, coords, labels = images.to(device), coords.to(device), labels.to(device)
            optimizer.zero_grad()
            logits = model(images, coords)
            loss = F.cross_entropy(logits, labels)
            loss.backward()
            optimizer.step()

            total_loss += loss.item()
            preds = torch.argmax(logits, dim=-1)
            correct += (preds == labels).sum().item()
            total += labels.size(0)

        acc = correct / total * 100
        avg_loss = total_loss / len(loader)
        print(f"Epoch {epoch+1} | Loss: {avg_loss:.4f} | Accuracy: {acc:.2f}%")

    torch.save(model.state_dict(), "ui_state_detector.pth")
    print("✅ Model saved as ui_state_detector.pth")

# ----------------------------
# USAGE EXAMPLE
# ----------------------------
if __name__ == "__main__":
    # Your CSV file should include: image_path, x1, y1, x2, y2, screen_w, screen_h, label
    csv_train = "data/train.csv"
    img_dir = "data/images"
    label_list = ["ON", "OFF", "DISABLED", "SELECTED", "UNSELECTED"]

    train_model(csv_train, img_dir, label_list, num_epochs=10, batch_size=8)
