#define TAG "InputMonitor"
#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, TAG, __VA_ARGS__)

extern "C"
JNIEXPORT void JNICALL
Java_com_example_globaltouchmonitor_MainActivity_startInputListener(JNIEnv *, jobject) {
    const char* input_dir = "/dev/input";
    DIR* dir = opendir(input_dir);
    if (!dir) {
        LOGI("Failed to open /dev/input");
        return;
    }

    std::vector<int> fds;
    struct dirent* entry;
    while ((entry = readdir(dir)) != nullptr) {
        if (strncmp(entry->d_name, "event", 5) == 0) {
            std::string path = std::string(input_dir) + "/" + entry->d_name;
            int fd = open(path.c_str(), O_RDONLY);
            if (fd >= 0) {
                fds.push_back(fd);
                LOGI("Opened input device: %s", path.c_str());
            }
        }
    }
    closedir(dir);

    struct input_event ev;
    int x = -1, y = -1;

    while (true) {
        for (int fd : fds) {
            ssize_t n = read(fd, &ev, sizeof(ev));
            if (n == sizeof(ev)) {
                if (ev.type == EV_ABS) {
                    if (ev.code == ABS_MT_POSITION_X || ev.code == ABS_X) {
                        x = ev.value;
                    } else if (ev.code == ABS_MT_POSITION_Y || ev.code == ABS_Y) {
                        y = ev.value;
                    }
                }

                if (ev.type == EV_SYN && x != -1 && y != -1) {
                    LOGI("Touch at x=%d, y=%d", x, y);
                    x = y = -1;
                }
            }
        }
        usleep(5000);
    }

    for (int fd : fds) {
        close(fd);
    }
}


