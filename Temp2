from PIL import Image

def resize_with_padding(img, target_size=224):
    w, h = img.size
    scale = target_size / max(w, h)
    new_w, new_h = int(w * scale), int(h * scale)
    img = img.resize((new_w, new_h))
    
    new_img = Image.new("RGB", (target_size, target_size), (0, 0, 0))
    new_img.paste(img, ((target_size - new_w) // 2, (target_size - new_h) // 2))
    return new_img


import os
from PIL import Image

def downscale_images(input_folder):
    # Create output folders in same directory as input folder
    parent_dir = os.path.dirname(os.path.abspath(input_folder))
    half_folder = os.path.join(parent_dir, "scaled_half")
    quarter_folder = os.path.join(parent_dir, "scaled_quarter")

    os.makedirs(half_folder, exist_ok=True)
    os.makedirs(quarter_folder, exist_ok=True)

    # Supported image extensions
    valid_ext = ('.jpg', '.jpeg', '.png', '.bmp', '.webp')

    # Iterate over images in input folder
    for filename in os.listdir(input_folder):
        if filename.lower().endswith(valid_ext):
            img_path = os.path.join(input_folder, filename)
            try:
                with Image.open(img_path) as img:
                    w, h = img.size

                    # Downscale 1/2
                    half_img = img.resize((w // 2, h // 2), Image.LANCZOS)
                    half_img.save(os.path.join(half_folder, filename))

                    # Downscale 1/4
                    quarter_img = img.resize((w // 4, h // 4), Image.LANCZOS)
                    quarter_img.save(os.path.join(quarter_folder, filename))

                    print(f"✅ Processed: {filename}")
            except Exception as e:
                print(f"⚠️ Skipped {filename} — {e}")

    print("\nAll done!")
    print(f"Half-size images → {half_folder}")
    print(f"Quarter-size images → {quarter_folder}")

if __name__ == "__main__":
    folder = input("Enter path of your image folder: ").strip()
    if os.path.isdir(folder):
        downscale_images(folder)
    else:
        print("❌ Invalid folder path.")
