class EditTextDataset(Dataset):
    def __init__(self, samples, image_root):
        self.samples = samples
        self.image_root = image_root

    def __getitem__(self, idx):
        s = self.samples[idx]
        pixel_values = load_image(
            os.path.join(self.image_root, s["image"])
        ).to(torch.bfloat16)

        prompt = "<image>\nDetect all edit text boxes."
        target = "\n".join([str(b) for b in s["boxes"]])

        return pixel_values, prompt, target

    def __len__(self):
        return len(self.samples)


model.train()

for pixel_values, prompt, target in loader:
    pixel_values = pixel_values[0].cuda()  # batch_size=1

    # InternVL handles image tokens internally
    response = model.chat(
        tokenizer,
        pixel_values,
        prompt,
        generation_config=dict(max_new_tokens=256),
        history=None
    )

    # Language loss only (instruction tuning)
    loss = model.compute_loss(response, target)

    loss.backward()
    optimizer.step()
    optimizer.zero_grad()


