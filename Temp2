def collate_fn(batch, tokenizer):
    assert len(batch) == 1, "InternVL requires batch_size=1"

    item = batch[0]

    # Remove <image> from text BEFORE tokenization
    prompt_text = item["prompt"].replace("<image>", "").strip()
    target_text = item["target"]

    full_text = prompt_text + "\n" + target_text

    tokens = tokenizer(
        full_text,
        return_tensors="pt",
        add_special_tokens=True
    )

    input_ids = tokens.input_ids           # [1, L]
    attention_mask = tokens.attention_mask # [1, L]

    pixel_values = item["pixel_values"]    # [N, 3, 448, 448]

    # 🔴 THIS IS THE KEY FIX 🔴
    # image_flags MUST match input_ids length
    image_flags = torch.zeros_like(input_ids, dtype=torch.bool)

    # InternVL replaces FIRST K tokens with vision embeddings
    num_image_tokens = min(pixel_values.shape[0], input_ids.shape[1])
    image_flags[0, :num_image_tokens] = True

    return {
        "input_ids": input_ids,
        "attention_mask": attention_mask,
        "pixel_values": pixel_values,
        "image_flags": image_flags
    }


assert isinstance(batch["image_flags"], torch.Tensor)
assert batch["image_flags"].dtype == torch.bool
assert batch["image_flags"].dim() == 2
assert batch["image_flags"].shape == batch["input_ids"].shape


