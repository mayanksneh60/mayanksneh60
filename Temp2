import torch
from yolox.exp import get_exp
from yolox.utils import fuse_model


# ==========================
# EDIT THESE
# ==========================
EXP_FILE = "exps/example/custom/yolox_s.py"
CKPT_FILE = "best_ckpt.pth"
OUTPUT_ONNX = "yolox_decode.onnx"
INPUT_SIZE = 640
# ==========================


class YOLOXWithDecode(torch.nn.Module):
    def __init__(self, model):
        super().__init__()
        self.model = model
        self.head = model.head

    def forward(self, x):
        outputs = self.model.backbone(x)
        outputs = self.head(outputs)

        # 🔥 FORCE decode here
        outputs = self.head.decode_outputs(outputs, dtype=outputs.dtype)

        return outputs


def main():

    exp = get_exp(EXP_FILE, None)
    model = exp.get_model()
    model.eval()

    ckpt = torch.load(CKPT_FILE, map_location="cpu")
    model.load_state_dict(ckpt["model"])

    model = fuse_model(model)

    model_with_decode = YOLOXWithDecode(model)
    model_with_decode.eval()

    dummy = torch.randn(1, 3, INPUT_SIZE, INPUT_SIZE)

    torch.onnx.export(
        model_with_decode,
        dummy,
        OUTPUT_ONNX,
        input_names=["images"],
        output_names=["output"],
        opset_version=12,
    )

    print("✅ Exported ONNX with decode FORCED into graph.")


if __name__ == "__main__":
    main()
