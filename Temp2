output_dir = "output_results"
os.makedirs(output_dir, exist_ok=True)

for img_name in image_files:

    img_path = os.path.join(IMAGE_FOLDER, img_name)
    print(f"Inferencing: {img_name}")

    img = cv2.imread(img_path)
    orig_img = img.copy()
    height, width = img.shape[:2]

    img_processed, ratio = preproc(img, INPUT_SIZE)
    img_tensor = torch.from_numpy(img_processed).unsqueeze(0).float().to(DEVICE)

    with torch.no_grad():
        outputs = model(img_tensor)
        outputs = postprocess(
            outputs,
            exp.num_classes,
            CONF_THRES,
            NMS_THRES
        )

    if outputs[0] is None:
        print("No detections")
        cv2.imwrite(os.path.join(output_dir, img_name), orig_img)
        continue

    detections = outputs[0].cpu().numpy()

    for det in detections:
        x1, y1, x2, y2, obj_conf, class_conf, class_id = det

        x1 /= ratio
        y1 /= ratio
        x2 /= ratio
        y2 /= ratio

        x1, y1, x2, y2 = map(int, [x1, y1, x2, y2])
        score = obj_conf * class_conf
        label = CLASS_NAMES[int(class_id)]

        cv2.rectangle(orig_img, (x1, y1), (x2, y2), (0, 255, 0), 2)
        cv2.putText(
            orig_img,
            f"{label}: {score:.2f}",
            (x1, y1 - 5),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            (0, 255, 0),
            2
        )

    save_path = os.path.join(output_dir, img_name)
    cv2.imwrite(save_path, orig_img)
    print(f"Saved: {save_path}")

print("Inference complete.")
