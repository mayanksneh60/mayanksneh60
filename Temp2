# EXAMPLE USAGE
# ----------------------------
if __name__ == "__main__":
    label_list = ["ON", "OFF", "DISABLED", "SELECTED", "UNSELECTED"]

    image_path = "data/images/sample_screenshot.jpg"  # path to your screenshot
    coords = (320, 1400, 420, 1500)                   # example bounding box (x1, y1, x2, y2)
    screen_w, screen_h = 1080, 2400                   # actual device screen size

    infer(image_path, coords, screen_w, screen_h, label_list)
