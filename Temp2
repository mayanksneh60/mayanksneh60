import cv2
import numpy as np
import tensorflow as tf

def sigmoid(x):
    return 1 / (1 + np.exp(-np.clip(x, -20, 20)))

def pre_process(image, input_size=(640, 640)):
    padded_img = np.ones((input_size[0], input_size[1], 3), dtype=np.uint8) * 114
    r = min(input_size[0] / image.shape[0], input_size[1] / image.shape[1])
    resized_img = cv2.resize(image, (int(image.shape[1] * r), int(image.shape[0] * r)))
    padded_img[:int(image.shape[0] * r), :int(image.shape[1] * r)] = resized_img
    padded_img = padded_img.transpose((2, 0, 1))
    return np.ascontiguousarray(padded_img, dtype=np.float32) / 255.0, r

def decode_outputs(outputs, input_size, p6=False):
    grids = []
    expanded_strides = []
    strides = [8, 16, 32] if not p6 else [8, 16, 32, 64]

    for stride in strides:
        hsize, wsize = input_size[0] // stride, input_size[1] // stride
        grid_y, grid_x = np.meshgrid(np.arange(hsize), np.arange(wsize))
        grid = np.stack((grid_x, grid_y), axis=-1).reshape(-1, 2)
        grids.append(grid)
        expanded_strides.append(np.full((grid.shape[0], 1), stride))

    grids = np.concatenate(grids, axis=0)
    expanded_strides = np.concatenate(expanded_strides, axis=0)

    # Decode box center and size
    outputs[..., :2] = (outputs[..., :2] + grids) * expanded_strides
    outputs[..., 2:4] = np.exp(np.clip(outputs[..., 2:4], -10, 10)) * expanded_strides
    
    # Convert center-xywh to corner-x1y1x2y2
    outputs[..., 0] = outputs[..., 0] - outputs[..., 2] / 2
    outputs[..., 1] = outputs[..., 1] - outputs[..., 3] / 2
    outputs[..., 2] = outputs[..., 0] + outputs[..., 2]
    outputs[..., 3] = outputs[..., 1] + outputs[..., 3]
    return outputs

def run_inference(model_path, image_path):
    interpreter = tf.lite.Interpreter(model_path=model_path)
    interpreter.allocate_tensors()
    
    img = cv2.imread(image_path)
    h, w, _ = img.shape
    input_data, ratio = pre_process(img)
    
    interpreter.set_tensor(interpreter.get_input_details()[0]['index'], [input_data])
    interpreter.invoke()
    output = interpreter.get_tensor(interpreter.get_output_details()[0]['index'])[0]

    # Apply Sigmoid to confidence and class scores
    output[..., 4:] = sigmoid(output[..., 4:])
    predictions = decode_outputs(output, (640, 640))

    scores = predictions[:, 4] * np.max(predictions[:, 5:], axis=1)
    mask = scores > 0.45 # Increased threshold to reduce noise
    
    # Scale boxes back to original image and CLIP to image boundaries
    boxes = predictions[mask, :4] / ratio
    boxes[:, [0, 2]] = np.clip(boxes[:, [0, 2]], 0, w)
    boxes[:, [1, 3]] = np.clip(boxes[:, [1, 3]], 0, h)
    
    final_scores = scores[mask]
    final_classes = np.argmax(predictions[mask, 5:], axis=1)

    for i in range(len(boxes)):
        x1, y1, x2, y2 = boxes[i].astype(int)
        # Filter out "collapsed" boxes (zero width or height)
        if (x2 - x1) < 5 or (y2 - y1) < 5: continue
            
        color = (0, 0, 255) if final_classes[i] == 0 else (0, 255, 0)
        cv2.rectangle(img, (x1, y1), (x2, y2), color, 2)
        print(f"Detected at: [{x1}, {y1}, {x2}, {y2}] with score {final_scores[i]:.2f}")

    cv2.imshow("Corrected Detections", img)
    cv2.waitKey(0)

if __name__ == "__main__":
    run_inference("best_ckpt_yolox_200epoch_mllm_all_neg.tflite", "test.jpg")
