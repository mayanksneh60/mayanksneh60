# ==========================
# YOLOX GRID DECODE + POSTPROCESS
# ==========================
print("\n==============================")
print("Processing detections with YOLOX decode...")
print("==============================")

def sigmoid(x):
    return 1 / (1 + np.exp(-x))

# YOLOX strides
strides = [8, 16, 32]

# Generate grid
grids = []
expanded_strides = []

for stride in strides:
    hsize = INPUT_SIZE // stride
    wsize = INPUT_SIZE // stride

    xv, yv = np.meshgrid(np.arange(wsize), np.arange(hsize))
    grid = np.stack((xv, yv), 2).reshape(-1, 2)
    grids.append(grid)
    expanded_strides.append(np.full((grid.shape[0], 1), stride))

grids = np.concatenate(grids, axis=0)
expanded_strides = np.concatenate(expanded_strides, axis=0)

# Apply sigmoid to obj + class
predictions[:, 4:] = sigmoid(predictions[:, 4:])

# Decode boxes
pred_boxes = np.zeros_like(predictions[:, :4])

pred_boxes[:, 0:2] = (predictions[:, 0:2] + grids) * expanded_strides
pred_boxes[:, 2:4] = np.exp(predictions[:, 2:4]) * expanded_strides

boxes = []
scores = []
class_ids = []

for i in range(len(pred_boxes)):
    obj_conf = predictions[i, 4]
    class_scores = predictions[i, 5:]

    class_id = np.argmax(class_scores)
    class_score = class_scores[class_id]

    score = obj_conf * class_score

    if score > CONF_THRESHOLD:
        x_center, y_center, w, h = pred_boxes[i]

        x1 = (x_center - w / 2) * orig_w / INPUT_SIZE
        y1 = (y_center - h / 2) * orig_h / INPUT_SIZE
        x2 = (x_center + w / 2) * orig_w / INPUT_SIZE
        y2 = (y_center + h / 2) * orig_h / INPUT_SIZE

        boxes.append([int(x1), int(y1), int(x2), int(y2)])
        scores.append(float(score))
        class_ids.append(class_id)

print("Detections above confidence threshold:", len(boxes))
