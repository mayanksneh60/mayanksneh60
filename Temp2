import json

input_json = "instances_train2017.json"
output_json = "instances_train2017_fixed.json"

with open(input_json) as f:
    data = json.load(f)

# Fix categories
for i,cat in enumerate(data["categories"]):
    cat["id"] = i

# Fix annotations
for ann in data["annotations"]:
    ann["category_id"] -= 1

with open(output_json,"w") as f:
    json.dump(data,f)

print("Fixed class IDs")
