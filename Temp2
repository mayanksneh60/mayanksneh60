from sklearn.model_selection import train_test_split
from PIL import Image
import torch
import torch.nn.functional as F
import torch.optim as optim
from torch.utils.data import DataLoader
from torchvision import transforms
from tqdm import tqdm
import pandas as pd
import os


# --- Helper: Resize with padding ---
def resize_with_padding(img, target_size=224):
    w, h = img.size
    scale = target_size / max(w, h)
    new_w, new_h = int(w * scale), int(h * scale)
    img = img.resize((new_w, new_h))
    new_img = Image.new("RGB", (target_size, target_size), (0, 0, 0))
    new_img.paste(img, ((target_size - new_w) // 2, (target_size - new_h) // 2))
    return new_img


# --- Modified UIScreenshotDataset to apply aspect-ratio-preserving resize ---
class UIScreenshotDataset(torch.utils.data.Dataset):
    def __init__(self, df, img_dir, label2id, transform=None):
        self.data = df
        self.img_dir = img_dir
        self.transform = transform
        self.label2id = label2id

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        row = self.data.iloc[idx]
        img_path = os.path.join(self.img_dir, row["image_path"])
        image = Image.open(img_path).convert("RGB")

        # Apply aspect ratio preserving resize
        image = resize_with_padding(image)

        # Transform
        if self.transform:
            image = self.transform(image)

        # Coordinates (normalized)
        x1, y1, x2, y2 = row["x1"], row["y1"], row["x2"], row["y2"]
        screen_w, screen_h = row["screen_w"], row["screen_h"]
        coords = torch.tensor([
            x1 / screen_w,
            y1 / screen_h,
            x2 / screen_w,
            y2 / screen_h
        ], dtype=torch.float32)

        label = torch.tensor(self.label2id[row["label"]], dtype=torch.long)
        return image, coords, label


# --- Updated training function ---
def train_model(csv_train, img_dir, label_list, num_epochs=50, batch_size=8, lr=2e-4, model_type="efficientnet_b2"):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Using device: {device}")

    label2id = {label: i for i, label in enumerate(label_list)}

    transform = transforms.Compose([
        transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.1),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406],
                             [0.229, 0.224, 0.225]),
    ])

    # Load CSV and split
    full_df = pd.read_csv(csv_train)
    train_df, val_df = train_test_split(full_df, test_size=0.1, random_state=42, shuffle=True)

    # Datasets
    train_dataset = UIScreenshotDataset(train_df.reset_index(drop=True), img_dir, label2id, transform)
    val_dataset = UIScreenshotDataset(val_df.reset_index(drop=True), img_dir, label2id, transform)

    # Dataloaders
    train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True, num_workers=4)
    val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False, num_workers=2)

    # Model
    model = UIStateDetector(num_classes=len(label_list), model_type=model_type).to(device)
    optimizer = optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)

    best_val_loss = float("inf")
    patience, patience_counter = 5, 0

    for epoch in range(num_epochs):
        # --- TRAIN ---
        model.train()
        total_loss, correct, total = 0, 0, 0

        for images, coords, labels in tqdm(train_loader, desc=f"Epoch {epoch+1}/{num_epochs} [Train]"):
            images, coords, labels = images.to(device), coords.to(device), labels.to(device)
            optimizer.zero_grad()
            logits = model(images, coords)
            loss = F.cross_entropy(logits, labels)
            loss.backward()
            optimizer.step()

            total_loss += loss.item()
            preds = torch.argmax(logits, dim=-1)
            correct += (preds == labels).sum().item()
            total += labels.size(0)

        train_acc = correct / total * 100
        avg_train_loss = total_loss / len(train_loader)

        # --- VALIDATION ---
        model.eval()
        val_loss, val_correct, val_total = 0, 0, 0
        with torch.no_grad():
            for images, coords, labels in tqdm(val_loader, desc=f"Epoch {epoch+1}/{num_epochs} [Val]"):
                images, coords, labels = images.to(device), coords.to(device), labels.to(device)
                logits = model(images, coords)
                loss = F.cross_entropy(logits, labels)
                val_loss += loss.item()
                preds = torch.argmax(logits, dim=-1)
                val_correct += (preds == labels).sum().item()
                val_total += labels.size(0)

        avg_val_loss = val_loss / len(val_loader)
        val_acc = val_correct / val_total * 100

        print(f"Epoch {epoch+1}: "
              f"Train Loss {avg_train_loss:.4f} | Train Acc {train_acc:.2f}% || "
              f"Val Loss {avg_val_loss:.4f} | Val Acc {val_acc:.2f}%")

        # --- EARLY STOPPING ---
        if avg_val_loss < best_val_loss:
            best_val_loss = avg_val_loss
            patience_counter = 0
            torch.save(model.state_dict(), "best_ui_state_detector.pth")
            print("💾 Saved best model (val loss improved)")
        else:
            patience_counter += 1
            print(f"⚠️ No improvement ({patience_counter}/{patience})")

            if patience_counter >= patience:
                print("⏹️ Early stopping triggered!")
                break

    print("✅ Training complete. Best model saved as 'best_ui_state_detector.pth'")
