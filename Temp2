old_embed = model.get_input_embeddings()
old_num_tokens, embed_dim = old_embed.weight.shape

new_num_tokens = len(tokenizer)

if new_num_tokens > old_num_tokens:
    new_embed = torch.nn.Embedding(
        new_num_tokens,
        embed_dim,
        device=old_embed.weight.device,
        dtype=old_embed.weight.dtype,
    )

    # copy existing weights
    new_embed.weight.data[:old_num_tokens] = old_embed.weight.data

    # init new token(s)
    torch.nn.init.normal_(
        new_embed.weight.data[old_num_tokens:],
        mean=0.0,
        std=embed_dim ** -0.5,
    )

    model.set_input_embeddings(new_embed)
