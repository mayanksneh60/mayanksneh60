import math
import torchvision.transforms as T
import torch
from PIL import Image

IMAGENET_MEAN = [0.485, 0.456, 0.406]
IMAGENET_STD  = [0.229, 0.224, 0.225]
PATCH_SIZE = 14


def preprocess_image_internvl(img: Image.Image, max_side=1024):
    """
    1. Resize keeping aspect ratio
    2. Pad so H and W are divisible by 14
    """
    w, h = img.size
    scale = max_side / max(w, h)
    new_w = int(w * scale)
    new_h = int(h * scale)

    img = img.resize((new_w, new_h), Image.BICUBIC)

    # Convert to tensor first
    img = T.ToTensor()(img)

    # Pad to multiple of PATCH_SIZE
    pad_h = (PATCH_SIZE - img.shape[1] % PATCH_SIZE) % PATCH_SIZE
    pad_w = (PATCH_SIZE - img.shape[2] % PATCH_SIZE) % PATCH_SIZE

    img = torch.nn.functional.pad(
        img,
        (0, pad_w, 0, pad_h),  # (left, right, top, bottom)
        value=0.0
    )

    img = T.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD)(img)

    return img



img_tensor = preprocess_image_internvl(img)


_, H, W = img_tensor.shape
assert H % 14 == 0 and W % 14 == 0, (H, W)
