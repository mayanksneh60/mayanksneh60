import json

input_file = "annotations.json"
output_file = "annotations_modified.json"

# Load coco json
with open(input_file, "r") as f:
    coco = json.load(f)

# 1. Remove all existing categories
coco["categories"] = []

# 2. Add the two new categories
coco["categories"] = [
    {"id": 1, "name": "Enabled", "supercategory": "UI"},
    {"id": 2, "name": "Disabled", "supercategory": "UI"}
]

# 3. Also update annotations’ category_ids (optional)
# If you don’t update them, the annotations will have invalid category_ids.
# Set everything to -1 for now so you can manually re-label later.

for ann in coco["annotations"]:
    ann["category_id"] = -1     # or 1/2 if you already know the state

# Save file
with open(output_file, "w") as f:
    json.dump(coco, f, indent=2)

print("Done! Categories replaced.")
