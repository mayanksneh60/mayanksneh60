import os
import cv2
from ultralytics import YOLO

# -------- CONFIG --------
IMAGE_DIR = "images"      # folder containing images
MODEL_PATH = "yolo.pt"    # your YOLO model
EXIT_KEY = ord('q')       # press 'q' to quit
# ------------------------

# Load model
model = YOLO(MODEL_PATH)

# Get all images
image_files = sorted([
    f for f in os.listdir(IMAGE_DIR)
    if f.lower().endswith(('.jpg', '.png', '.jpeg', '.bmp'))
])

print(f"Found {len(image_files)} images")

for img_name in image_files:
    img_path = os.path.join(IMAGE_DIR, img_name)

    img = cv2.imread(img_path)
    if img is None:
        print(f"Skipping unreadable image: {img_name}")
        continue

    # YOLO inference
    results = model(img)

    # Draw predictions
    annotated = results[0].plot()

    # Show image
    cv2.imshow("YOLO Inference", annotated)
    print(f"Showing: {img_name} | Press 'q' to exit, any other key for next")

    key = cv2.waitKey(0) & 0xFF
    if key == EXIT_KEY:
        print("Exit requested by user")
        break

cv2.destroyAllWindows()
