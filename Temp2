import os
import sys
import torch
import onnx
import tensorflow as tf
from loguru import logger

# -------------------------------------------------
# 🔥 IMPORTANT: ADD YOLOX TO PYTHON PATH
# -------------------------------------------------
YOLOX_PATH = "./YOLOX"   # change if needed
sys.path.append(YOLOX_PATH)

from yolox.exp import get_exp


# =================================================
# CONFIGURATION
# =================================================
EXP_FILE = "exps/example/yolox_edittext_nano.py"   # <-- YOUR EXP FILE
CKPT_FILE = "YOLOX_outputs/yolox_edittext_nano/best_ckpt.pth"
ONNX_FILE = "yolox.onnx"
ONNX_SIM_FILE = "yolox_sim.onnx"
TF_MODEL_DIR = "yolox_saved_model"
TFLITE_FILE = "yolox_fp16.tflite"

INPUT_SIZE = 640


# =================================================
# STEP 1 — LOAD MODEL
# =================================================
print("\n🚀 Loading YOLOX model...")

exp = get_exp(EXP_FILE, None)
model = exp.get_model()

ckpt = torch.load(CKPT_FILE, map_location="cpu")

if "model" in ckpt:
    model.load_state_dict(ckpt["model"])
else:
    model.load_state_dict(ckpt)

model.eval()

# 🔥 VERY IMPORTANT — enable decode in inference
model.head.decode_in_inference = True
model.head.use_l1 = False

print("✅ Model loaded successfully")


# =================================================
# STEP 2 — EXPORT TO ONNX
# =================================================
print("\n📦 Exporting to ONNX...")

dummy_input = torch.randn(1, 3, INPUT_SIZE, INPUT_SIZE)

torch.onnx.export(
    model,
    dummy_input,
    ONNX_FILE,
    input_names=["input"],
    output_names=["output"],
    opset_version=11,
    do_constant_folding=True,
)

print("✅ ONNX export complete")


# =================================================
# STEP 3 — SIMPLIFY ONNX
# =================================================
print("\n🔧 Simplifying ONNX...")

import onnxsim

model_onnx = onnx.load(ONNX_FILE)
model_sim, check = onnxsim.simplify(model_onnx)

if not check:
    raise RuntimeError("ONNX simplification failed")

onnx.save(model_sim, ONNX_SIM_FILE)

print("✅ ONNX simplified")


# =================================================
# STEP 4 — ONNX → TensorFlow
# =================================================
print("\n🔄 Converting ONNX → TensorFlow...")

from onnx_tf.backend import prepare

onnx_model = onnx.load(ONNX_SIM_FILE)
tf_rep = prepare(onnx_model)
tf_rep.export_graph(TF_MODEL_DIR)

print("✅ SavedModel exported")


# =================================================
# STEP 5 — TensorFlow → TFLite (FP16)
# =================================================
print("\n📱 Converting to TFLite FP16...")

converter = tf.lite.TFLiteConverter.from_saved_model(TF_MODEL_DIR)

converter.optimizations = [tf.lite.Optimize.DEFAULT]
converter.target_spec.supported_types = [tf.float16]
converter.experimental_new_converter = True

tflite_model = converter.convert()

with open(TFLITE_FILE, "wb") as f:
    f.write(tflite_model)

print("\n🎉 SUCCESS!")
print("TFLite model saved as:", TFLITE_FILE)
