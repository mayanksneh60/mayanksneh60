def collate_fn(batch, tokenizer):
    assert len(batch) == 1, "InternVL requires batch_size=1"

    item = batch[0]

    # Prepare text (remove <image> marker)
    text = item["prompt"].replace("<image>", "").strip()
    target = item["target"]
    full_text = text + "\n" + target

    tokens = tokenizer(
        full_text,
        return_tensors="pt",
        add_special_tokens=True
    )

    input_ids = tokens.input_ids          # [1, L]
    attention_mask = tokens.attention_mask

    pixel_values = item["pixel_values"]   # [N, 3, 448, 448]
    num_image_tokens = pixel_values.shape[0]

    # ✅ THIS IS THE KEY
    image_flags = torch.ones(
        (num_image_tokens,),
        dtype=torch.bool
    )

    return {
        "input_ids": input_ids,
        "attention_mask": attention_mask,
        "pixel_values": pixel_values,
        "image_flags": image_flags
    }


assert batch["image_flags"].dim() == 1
assert batch["image_flags"].dtype == torch.bool
assert batch["image_flags"].shape[0] == batch["pixel_values"].shape[0]
