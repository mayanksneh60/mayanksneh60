ui_elements = {
    "button_play": (100, 200, 200, 300),
    "button_pause": (210, 200, 310, 300),
    "button_stop": (320, 200, 420, 300),
    "icon_settings": (50, 50, 120, 120),
    "slider_volume": (150, 400, 950, 420),
    "text_title": (100, 100, 600, 160),
    "icon_home": (10, 2000, 120, 2100),
    "icon_back": (10, 100, 100, 180),
    "tab_recent": (400, 2200, 600, 2250),
    "tab_favorites": (650, 2200, 850, 2250),
    "button_next": (900, 2100, 1050, 2200),
    "button_prev": (50, 2100, 200, 2200),
    "icon_user": (950, 50, 1050, 150)
}

INPUT_CSV = "input.csv"
OUTPUT_CSV = "output.csv"

SCREEN_WIDTH = 1080
SCREEN_HEIGHT = 2340

# Read input and generate output
with open(INPUT_CSV, newline='') as infile, open(OUTPUT_CSV, 'w', newline='') as outfile:
    reader = csv.reader(infile)
    writer = csv.writer(outfile)

    # Write header (optional)
    writer.writerow(["image_name", "x1", "y1", "x2", "y2", "width", "height", "state"])

    for row in reader:
        if len(row) < 2:
            continue  # skip invalid lines
        
        img_name = row[0].strip()
        # Allow multiple ON elements in one row
        on_elements = {elem.strip() for elem in row[1:] if elem.strip()}

        for element_name, (x1, y1, x2, y2) in ui_elements.items():
            state = "ON" if element_name in on_elements else "OFF"
            writer.writerow([img_name, x1, y1, x2, y2, SCREEN_WIDTH, SCREEN_HEIGHT, state])

print(f"✅ Output written to {OUTPUT_CSV}")






UI State Detection Flow

1️⃣ Input Stage

Inputs:
	•	📱 Full UI screenshot (RGB image)
	•	🔲 Coordinates of the UI element: (x1, y1, x2, y2)
	•	📏 Screen dimensions: (screen_w, screen_h)

🧩 Goal: To tell the model which UI element on the screen to analyze.

⸻

2️⃣ Preprocessing Stage
	•	🖼️ Image is resized to 224×224
	•	🎨 Image is normalized (same as ImageNet mean/std)
	•	🔢 Coordinates are normalized by dividing with screen_w and screen_h
→ ensures values are between 0–1 and device-independent.

⸻

3️⃣ Feature Extraction

🔹 Visual Encoder
	•	Uses EfficientNet-B2 (pretrained backbone)
	•	Extracts visual features from the screenshot
	•	Outputs a 1408-dimensional vector representing the visual context.

🔹 Coordinate Encoder
	•	Small feed-forward network (MLP)
	•	Converts normalized coordinates → 128-dimensional vector.

⸻

4️⃣ Fusion + Classification

🔗 Both encoded vectors are concatenated → [Visual Features + Coordinate Features]
🔻
Then passed through a Classifier Head:
	•	Dense → ReLU → Dropout → Dense
	•	Outputs logits for each class (e.g., ON, OFF, DISABLED, etc.)

⸻

5️⃣ Output Stage
	•	🔍 Model predicts the most probable UI state









import torch
import torch.nn as nn
from torchvision import models, transforms
from PIL import Image

# ----------------------------
# MODEL DEFINITION (same as training)
# ----------------------------
class UIStateDetector(nn.Module):
    def __init__(self, num_classes=5, model_type="efficientnet_b2"):
        super().__init__()

        if model_type == "efficientnet_b2":
            backbone = models.efficientnet_b2(weights=None)
            state_dict = torch.load("efficientnet_b2_rwightman-c35c1473.pth", map_location="cpu")
            backbone.load_state_dict(state_dict)
            self.visual_encoder = backbone.features
            visual_out_dim = 1408
        else:
            raise ValueError("Unknown model_type")

        self.coord_encoder = nn.Sequential(
            nn.Linear(4, 64),
            nn.ReLU(),
            nn.Linear(64, 128),
            nn.ReLU(),
        )

        self.classifier = nn.Sequential(
            nn.Linear(visual_out_dim + 128, 512),
            nn.ReLU(),
            nn.Dropout(0.3),
            nn.Linear(512, num_classes),
        )

        self.global_pool = nn.AdaptiveAvgPool2d((1, 1))

    def forward(self, image, coords):
        vision_feat = self.visual_encoder(image)
        vision_feat = self.global_pool(vision_feat)
        vision_feat = vision_feat.view(vision_feat.size(0), -1)
        coord_feat = self.coord_encoder(coords)
        fused = torch.cat([vision_feat, coord_feat], dim=-1)
        logits = self.classifier(fused)
        return logits


# ----------------------------
# INFERENCE FUNCTION
# ----------------------------
def infer(image_path, coords, screen_w, screen_h, label_list):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    # Load model
    model = UIStateDetector(num_classes=len(label_list)).to(device)
    model.load_state_dict(torch.load("ui_state_detector.pth", map_location=device))
    model.eval()

    # Image preprocessing (same as training)
    transform = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406],
                             [0.229, 0.224, 0.225]),
    ])

    image = Image.open(image_path).convert("RGB")
    image = transform(image).unsqueeze(0).to(device)

    # Normalize coordinates
    x1, y1, x2, y2 = coords
    coord_tensor = torch.tensor([[
        x1 / screen_w,
        y1 / screen_h,
        x2 / screen_w,
        y2 / screen_h
    ]], dtype=torch.float32).to(device)

    # Predict
    with torch.no_grad():
        logits = model(image, coord_tensor)
        pred_id = torch.argmax(logits, dim=-1).item()
        pred_label = label_list[pred_id]

    print(f"🧩 Predicted State: {pred_label}")
    return pred_label


