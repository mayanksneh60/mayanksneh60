import cv2
import numpy as np
import os

os.makedirs("test_dataset/train2017", exist_ok=True)
os.makedirs("test_dataset/val2017", exist_ok=True)

def make_img(path):
    img = np.ones((400,400,3), dtype=np.uint8)*255
    cv2.rectangle(img,(100,150),(300,200),(0,0,255),2)
    cv2.imwrite(path,img)

make_img("test_dataset/train2017/img1.jpg")
make_img("test_dataset/train2017/img2.jpg")
make_img("test_dataset/val2017/img3.jpg")

print("images created")



