import os
import json
import shutil
import random
from PIL import Image

ROOT_DIR = "input_data"
OUTPUT_DIR = "dataset"

TRAIN_DIR = os.path.join(OUTPUT_DIR, "train2017")
VAL_DIR = os.path.join(OUTPUT_DIR, "val2017")
ANN_DIR = os.path.join(OUTPUT_DIR, "annotations")

os.makedirs(TRAIN_DIR, exist_ok=True)
os.makedirs(VAL_DIR, exist_ok=True)
os.makedirs(ANN_DIR, exist_ok=True)

# Categories
CATEGORIES = [
    {"id": 1, "name": "focused_edittext"},
    {"id": 2, "name": "normal_edittext"},
    {"id": 3, "name": "textview"},
]

def get_category_id(view):
    cls = view.get("class", "")
    focused = view.get("focused", False)

    if cls == "android.widget.EditText":
        return 1 if focused else 2
    elif cls == "android.widget.TextView":
        return 3
    return None


# Collect all image-json pairs
pairs = []

for folder in os.listdir(ROOT_DIR):
    folder_path = os.path.join(ROOT_DIR, folder)

    if not os.path.isdir(folder_path):
        continue

    for file in os.listdir(folder_path):
        if file.endswith(".jpg"):
            img_path = os.path.join(folder_path, file)
            json_path = img_path.replace(".jpg", ".json")

            if os.path.exists(json_path):
                pairs.append((img_path, json_path))

# Shuffle and split
random.shuffle(pairs)
split_idx = int(0.8 * len(pairs))

train_pairs = pairs[:split_idx]
val_pairs = pairs[split_idx:]


def create_coco(pairs, output_img_dir):
    images = []
    annotations = []
    ann_id = 1
    img_id = 1

    for img_path, json_path in pairs:
        img = Image.open(img_path)
        width, height = img.size

        file_name = f"{img_id}.jpg"
        shutil.copy(img_path, os.path.join(output_img_dir, file_name))

        images.append({
            "id": img_id,
            "file_name": file_name,
            "width": width,
            "height": height
        })

        with open(json_path, "r") as f:
            data = json.load(f)

        for view in data.get("views", []):
            category_id = get_category_id(view)
            if category_id is None:
                continue

            (x1, y1), (x2, y2) = view["bounds"]

            bbox = [x1, y1, x2 - x1, y2 - y1]
            area = (x2 - x1) * (y2 - y1)

            annotations.append({
                "id": ann_id,
                "image_id": img_id,
                "category_id": category_id,
                "bbox": bbox,
                "area": area,
                "iscrowd": 0
            })

            ann_id += 1

        img_id += 1

    return {
        "images": images,
        "annotations": annotations,
        "categories": CATEGORIES
    }


# Create datasets
train_coco = create_coco(train_pairs, TRAIN_DIR)
val_coco = create_coco(val_pairs, VAL_DIR)

# Save JSONs
with open(os.path.join(ANN_DIR, "instances_train2017.json"), "w") as f:
    json.dump(train_coco, f, indent=2)

with open(os.path.join(ANN_DIR, "instances_val2017.json"), "w") as f:
    json.dump(val_coco, f, indent=2)

print("✅ COCO dataset created successfully!")
