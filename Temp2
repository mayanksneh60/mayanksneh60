import os
import shutil
from tqdm import tqdm

SRC_ROOT = "yolo_dataset"
DST_ROOT = "yolo_dataset_filtered"

THRESHOLD = 300000
SPLITS = ["train", "val"]

IMG_EXTS = {".jpg", ".jpeg", ".png"}

for split in SPLITS:
    src_img_dir = os.path.join(SRC_ROOT, "images", split)
    src_lbl_dir = os.path.join(SRC_ROOT, "labels", split)

    dst_img_dir = os.path.join(DST_ROOT, "images", split)
    dst_lbl_dir = os.path.join(DST_ROOT, "labels", split)

    os.makedirs(dst_img_dir, exist_ok=True)
    os.makedirs(dst_lbl_dir, exist_ok=True)

    files = os.listdir(src_img_dir)

    for img in tqdm(files, desc=f"Processing {split}"):
        name, ext = os.path.splitext(img)

        if ext.lower() not in IMG_EXTS:
            continue

        if not name.isdigit():
            continue

        if int(name) < THRESHOLD:
            continue

        src_img = os.path.join(src_img_dir, img)
        src_lbl = os.path.join(src_lbl_dir, name + ".txt")

        # Copy image
        shutil.copy2(src_img, os.path.join(dst_img_dir, img))

        # Copy label only if exists
        if os.path.exists(src_lbl):
            shutil.copy2(src_lbl, os.path.join(dst_lbl_dir, name + ".txt"))
