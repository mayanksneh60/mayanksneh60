import android.content.Context
import android.graphics.Bitmap
import android.graphics.RectF
import org.tensorflow.lite.Interpreter
import java.nio.ByteBuffer
import java.nio.ByteOrder

class TFLiteDetector(context: Context) {

    private val interpreter: Interpreter
    private val inputWidth = 768
    private val inputHeight = 768
    private val confThreshold = 0.4f

    init {
        val model = context.assets.open("model.tflite").readBytes()
        interpreter = Interpreter(model)
    }

    fun detect(bitmap: Bitmap): List<Detection> {

        val origWidth = bitmap.width
        val origHeight = bitmap.height

        val resized = Bitmap.createScaledBitmap(bitmap, inputWidth, inputHeight, true)

        val inputBuffer = ByteBuffer.allocateDirect(1 * inputWidth * inputHeight * 3 * 4)
        inputBuffer.order(ByteOrder.nativeOrder())

        val pixels = IntArray(inputWidth * inputHeight)
        resized.getPixels(pixels, 0, inputWidth, 0, 0, inputWidth, inputHeight)

        var index = 0
        for (i in 0 until inputHeight) {
            for (j in 0 until inputWidth) {

                val pixel = pixels[index++]

                val r = ((pixel shr 16) and 0xFF) / 255.0f
                val g = ((pixel shr 8) and 0xFF) / 255.0f
                val b = (pixel and 0xFF) / 255.0f

                inputBuffer.putFloat(r)
                inputBuffer.putFloat(g)
                inputBuffer.putFloat(b)
            }
        }

        val classes = Array(1) { LongArray(150) }
        val boxes = Array(1) { Array(150) { FloatArray(4) } }
        val scores = Array(1) { FloatArray(150) }

        val outputs = HashMap<Int, Any>()
        outputs[0] = classes
        outputs[1] = boxes
        outputs[2] = scores

        interpreter.runForMultipleInputsOutputs(arrayOf(inputBuffer), outputs)

        val detections = mutableListOf<Detection>()

        for (i in 0 until 150) {

            val score = scores[0][i]
            if (score < confThreshold) continue

            val box = boxes[0][i]

            var x1 = box[0] * origWidth / inputWidth
            var y1 = box[1] * origHeight / inputHeight
            var x2 = box[2] * origWidth / inputWidth
            var y2 = box[3] * origHeight / inputHeight

            x1 = x1.coerceIn(0f, origWidth.toFloat())
            y1 = y1.coerceIn(0f, origHeight.toFloat())
            x2 = x2.coerceIn(0f, origWidth.toFloat())
            y2 = y2.coerceIn(0f, origHeight.toFloat())

            val rect = RectF(x1, y1, x2, y2)

            val detection = Detection(
                classId = classes[0][i].toInt(),
                score = score,
                box = rect
            )

            detections.add(detection)
        }

        return detections
    }
}
