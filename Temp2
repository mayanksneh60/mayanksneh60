data class Detection(
    val classId: Int,
    val confidence: Float,
    val left: Float,
    val top: Float,
    val right: Float,
    val bottom: Float
)



package com.example.yoloandroid

import android.graphics.*

data class LetterboxResult(
    val bitmap: Bitmap,
    val scale: Float,
    val padX: Float,
    val padY: Float
)

fun letterbox(src: Bitmap, dstSize: Int): LetterboxResult {
    val scale = minOf(
        dstSize.toFloat() / src.width,
        dstSize.toFloat() / src.height
    )

    val newW = (src.width * scale).toInt()
    val newH = (src.height * scale).toInt()

    val resized = Bitmap.createScaledBitmap(src, newW, newH, true)
    val output = Bitmap.createBitmap(dstSize, dstSize, Bitmap.Config.ARGB_8888)

    val canvas = Canvas(output)
    canvas.drawColor(Color.GRAY)

    val padX = (dstSize - newW) / 2f
    val padY = (dstSize - newH) / 2f

    canvas.drawBitmap(resized, padX, padY, Paint())

    return LetterboxResult(output, scale, padX, padY)
}




package com.example.yoloandroid

import android.graphics.*
import android.os.*
import android.widget.ImageView
import androidx.appcompat.app.AppCompatActivity

class MainActivity : AppCompatActivity() {

    private lateinit var imageView: ImageView
    private lateinit var yolo: YoloTFLite
    private lateinit var images: Array<String>
    private var index = 0

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        imageView = findViewById(R.id.imageView)
        yolo = YoloTFLite(this)

        images = assets.list("images")!!
        showNext()
    }

    private fun showNext() {
        if (index >= images.size) return

        val bmp = BitmapFactory.decodeStream(
            assets.open("images/${images[index]}")
        ).copy(Bitmap.Config.ARGB_8888, true)

        val detections = yolo.infer(bmp)

        drawBoxes(bmp, detections)
        imageView.setImageBitmap(bmp)

        index++
        Handler(Looper.getMainLooper()).postDelayed({ showNext() }, 1500)
    }

    private fun drawBoxes(bitmap: Bitmap, dets: List<Detection>) {
        val canvas = Canvas(bitmap)
        val boxPaint = Paint().apply {
            color = Color.RED
            style = Paint.Style.STROKE
            strokeWidth = 4f
        }
        val textPaint = Paint().apply {
            color = Color.RED
            textSize = 36f
        }

        for (d in dets) {
            canvas.drawRect(d.left, d.top, d.right, d.bottom, boxPaint)
            canvas.drawText(
                "ID:${d.classId}",
                d.left,
                d.top - 10,
                textPaint
            )
        }
    }
}




package com.example.yoloandroid

import android.content.Context
import android.graphics.Bitmap
import org.tensorflow.lite.Interpreter
import java.nio.ByteBuffer
import java.nio.ByteOrder

class YoloTFLite(
    context: Context,
    modelName: String = "yolov9c.tflite",
    private val inputSize: Int = 640,
    private val numClasses: Int = 80,
    private val confThreshold: Float = 0.25f
) {

    private val interpreter: Interpreter =
        Interpreter(context.assets.open(modelName).readBytes())

    fun infer(original: Bitmap): List<Detection> {

        // 1️⃣ Letterbox (keeps aspect ratio)
        val lb = letterbox(original, inputSize)

        // 2️⃣ Preprocess to Float32 NHWC
        val input = bitmapToBuffer(lb.bitmap)

        // 3️⃣ YOLOv9-C output buffer
        // Shape: [1, 84, 8400]
        val output = Array(1) { Array(5 + numClasses) { FloatArray(8400) } }

        // 4️⃣ Run inference
        interpreter.run(input, output)

        // 5️⃣ Parse + map back to original image
        return parseYOLOv9(
            output,
            lb.scale,
            lb.padX,
            lb.padY,
            original.width,
            original.height
        )
    }

    // ---------------- PREPROCESS ----------------

    private fun bitmapToBuffer(bitmap: Bitmap): ByteBuffer {
        val buffer =
            ByteBuffer.allocateDirect(1 * inputSize * inputSize * 3 * 4)
        buffer.order(ByteOrder.nativeOrder())

        for (y in 0 until inputSize) {
            for (x in 0 until inputSize) {
                val px = bitmap.getPixel(x, y)
                buffer.putFloat(((px shr 16) and 0xFF) / 255f) // R
                buffer.putFloat(((px shr 8) and 0xFF) / 255f)  // G
                buffer.putFloat((px and 0xFF) / 255f)         // B
            }
        }
        return buffer
    }

    // ---------------- YOLOv9 PARSER ----------------

    private fun parseYOLOv9(
        output: Array<Array<FloatArray>>,
        scale: Float,
        padX: Float,
        padY: Float,
        origW: Int,
        origH: Int
    ): List<Detection> {

        val results = mutableListOf<Detection>()

        val numBoxes = output[0][0].size
        val classOffset = 5  // cx,cy,w,h,obj

        for (i in 0 until numBoxes) {

            val objConf = output[0][4][i]
            if (objConf < confThreshold) continue

            // Find best class
            var classId = -1
            var bestScore = 0f
            for (c in 0 until numClasses) {
                val score = output[0][classOffset + c][i]
                if (score > bestScore) {
                    bestScore = score
                    classId = c
                }
            }

            val confidence = objConf * bestScore
            if (confidence < confThreshold) continue

            // Box (normalized → input size)
            val cx = output[0][0][i] * inputSize
            val cy = output[0][1][i] * inputSize
            val w  = output[0][2][i] * inputSize
            val h  = output[0][3][i] * inputSize

            // Reverse letterbox
            val x1 = (cx - w / 2 - padX) / scale
            val y1 = (cy - h / 2 - padY) / scale
            val x2 = (cx + w / 2 - padX) / scale
            val y2 = (cy + h / 2 - padY) / scale

            results.add(
                Detection(
                    classId = classId,
                    confidence = confidence,
                    left = x1.coerceIn(0f, origW.toFloat()),
                    top = y1.coerceIn(0f, origH.toFloat()),
                    right = x2.coerceIn(0f, origW.toFloat()),
                    bottom = y2.coerceIn(0f, origH.toFloat())
                )
            )
        }
        return results
    }
}
