import os
import csv
from collections import defaultdict

import torch
from torch.utils.data import Dataset, DataLoader
from PIL import Image
import torchvision.transforms as T

from transformers import AutoTokenizer, AutoModelForCausalLM, AdamW

# ================= CONFIG =================
MODEL_PATH = "/path/to/offline/InternVL3-78B"
CSV_PATH = "/path/to/annotations.csv"
IMAGE_ROOT = "/path/to/images"

DEVICE = "cuda"
BATCH_SIZE = 1
EPOCHS = 1
LR = 1e-5

IMAGE_SIZE = 448
IMAGE_TOKEN_SIZE = 256
IMAGE_TOKEN = "<image>"


def load_samples_from_csv(csv_path):
    grouped = defaultdict(list)

    with open(csv_path, "rb") as f:
        raw = f.read()

    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        text = raw.decode("utf-16")

    reader = csv.DictReader(text.splitlines())

    for row in reader:
        img = row["image_name"]

        x1 = float(row["x1"])
        y1 = float(row["y1"])
        x2 = float(row["x2"])
        y2 = float(row["y2"])
        sw = float(row["screen_width"])
        sh = float(row["screen_height"])

        grouped[img].append([
            x1 / sw,
            y1 / sh,
            x2 / sw,
            y2 / sh,
        ])

    samples = [
        {"image": img, "boxes": boxes}
        for img, boxes in grouped.items()
    ]

    print(f"Loaded {len(samples)} images from CSV")
    return samples



class EditTextDataset(Dataset):
    def __init__(self, samples, image_root, tokenizer):
        self.samples = samples
        self.image_root = image_root
        self.tokenizer = tokenizer

        self.transform = T.Compose([
            T.Resize(
                IMAGE_SIZE,
                interpolation=T.InterpolationMode.BICUBIC,
                max_size=IMAGE_SIZE
            ),
            T.ToTensor(),
            T.Normalize(
                mean=(0.485, 0.456, 0.406),
                std=(0.229, 0.224, 0.225)
            )
        ])

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        sample = self.samples[idx]

        # -------- IMAGE --------
        img_path = os.path.join(self.image_root, sample["image"])
        image = Image.open(img_path).convert("RGB")
        pixel_values = self.transform(image)  # [3,H,W]

        # -------- TARGET TEXT --------
        target_text = "; ".join(
            f"[{b[0]:.4f},{b[1]:.4f},{b[2]:.4f},{b[3]:.4f}]"
            for b in sample["boxes"]
        )

        # -------- PROMPT --------
        image_tokens = " ".join([IMAGE_TOKEN] * IMAGE_TOKEN_SIZE)

        prompt = (
            f"{image_tokens}\n"
            "Detect all edit text boxes and output normalized bounding boxes.\n"
            f"{target_text}"
        )

        tokenized = self.tokenizer(
            prompt,
            return_tensors="pt",
            add_special_tokens=True
        )

        input_ids = tokenized.input_ids[0]
        attention_mask = tokenized.attention_mask[0]

        # -------- IMAGE FLAGS --------
        image_flags = torch.zeros_like(input_ids, dtype=torch.long)
        image_flags[:IMAGE_TOKEN_SIZE] = 1

        # -------- ASSERTS (CRITICAL) --------
        assert image_flags.sum().item() == IMAGE_TOKEN_SIZE
        assert image_flags.shape == input_ids.shape
        assert input_ids.shape[0] >= IMAGE_TOKEN_SIZE

        return {
            "input_ids": input_ids,
            "attention_mask": attention_mask,
            "pixel_values": pixel_values,
            "image_flags": image_flags,
        }



def collate_fn(batch):
    max_len = max(len(x["input_ids"]) for x in batch)

    def pad(x, value=0):
        return torch.cat([
            x,
            torch.full((max_len - len(x),), value, dtype=x.dtype)
        ])

    return {
        "input_ids": torch.stack([pad(x["input_ids"]) for x in batch]),
        "attention_mask": torch.stack([pad(x["attention_mask"]) for x in batch]),
        "image_flags": torch.stack([pad(x["image_flags"]) for x in batch]),
        "pixel_values": torch.stack([x["pixel_values"] for x in batch]),
        "labels": torch.stack([pad(x["input_ids"]) for x in batch]),
    }

def main():
    samples = load_samples_from_csv(CSV_PATH)

    tokenizer = AutoTokenizer.from_pretrained(
        MODEL_PATH,
        trust_remote_code=True
    )

    # Add <image> token ONLY to tokenizer (NO resizing)
    if IMAGE_TOKEN not in tokenizer.get_vocab():
        tokenizer.add_special_tokens(
            {"additional_special_tokens": [IMAGE_TOKEN]}
        )

    model = AutoModelForCausalLM.from_pretrained(
        MODEL_PATH,
        trust_remote_code=True,
        torch_dtype=torch.bfloat16
    ).to(DEVICE)

    model.train()

    dataset = EditTextDataset(samples, IMAGE_ROOT, tokenizer)
    loader = DataLoader(
        dataset,
        batch_size=BATCH_SIZE,
        shuffle=True,
        collate_fn=collate_fn
    )

    optimizer = AdamW(model.parameters(), lr=LR)

    for epoch in range(EPOCHS):
        for step, batch in enumerate(loader):
            for k in batch:
                batch[k] = batch[k].to(DEVICE)

            outputs = model(
                input_ids=batch["input_ids"],
                attention_mask=batch["attention_mask"],
                pixel_values=batch["pixel_values"],
                image_flags=batch["image_flags"],
                labels=batch["labels"],
            )

            loss = outputs.loss
            loss.backward()

            optimizer.step()
            optimizer.zero_grad()

            if step % 10 == 0:
                print(f"Epoch {epoch} Step {step} Loss {loss.item():.4f}")

    print("✅ Training complete")


if __name__ == "__main__":
    main()
