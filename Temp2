import torch
import sys
from loguru import logger

# Add YOLOX path
sys.path.append("YOLOX")

from yolox.exp import get_exp
from yolox.utils import replace_module

# -------------------------
# CONFIG
# -------------------------
CKPT_FILE = "best_ckpt.pth"      # your trained checkpoint
ONNX_FILE = "yolox.onnx"
INPUT_SIZE = (640, 640)

# -------------------------
# Load Experiment
# -------------------------
exp = get_exp(None, "yolox_s")   # change to yolox_tiny / yolox_s etc
model = exp.get_model()

# Load checkpoint
ckpt = torch.load(CKPT_FILE, map_location="cpu")
model.load_state_dict(ckpt["model"])
model.eval()

# Disable training-only layers
model.head.decode_in_inference = True  # IMPORTANT
model.head.use_l1 = False

# -------------------------
# Dummy Input
# -------------------------
dummy_input = torch.randn(1, 3, INPUT_SIZE[0], INPUT_SIZE[1])

# -------------------------
# Export
# -------------------------
torch.onnx.export(
    model,
    dummy_input,
    ONNX_FILE,
    input_names=["input"],
    output_names=["output"],
    opset_version=11,
    do_constant_folding=True,
)

print("✅ Export complete: yolox.onnx")





import onnxruntime as ort
import numpy as np

session = ort.InferenceSession("yolox.onnx")

dummy = np.random.randn(1,3,640,640).astype(np.float32)
outputs = session.run(None, {"input": dummy})

print(outputs[0][0])
