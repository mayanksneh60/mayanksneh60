import android.graphics.Bitmap
import android.graphics.RectF
import org.tensorflow.lite.Interpreter
import java.nio.ByteBuffer
import java.nio.ByteOrder
import kotlin.math.exp
import kotlin.math.max
import kotlin.math.min

data class Detection(
    val classId: Int,
    val score: Float,
    val box: RectF
)

class YoloxTFLite(
    private val interpreter: Interpreter,
    private val inputSize: Int = 640,
    private val numClasses: Int = 2,
    private val confThreshold: Float = 0.25f,
    private val nmsThreshold: Float = 0.45f
) {

    private val numPredictions = 8400

    fun detect(bitmap: Bitmap): List<Detection> {

        val resized = Bitmap.createScaledBitmap(bitmap, inputSize, inputSize, true)

        val inputBuffer = ByteBuffer.allocateDirect(1 * 3 * inputSize * inputSize * 4)
        inputBuffer.order(ByteOrder.nativeOrder())
        inputBuffer.rewind()

        // NCHW format
        for (c in 0 until 3) {
            for (y in 0 until inputSize) {
                for (x in 0 until inputSize) {

                    val pixel = resized.getPixel(x, y)

                    val value = when (c) {
                        0 -> ((pixel shr 16 and 0xFF) / 255f) // R
                        1 -> ((pixel shr 8 and 0xFF) / 255f)  // G
                        else -> ((pixel and 0xFF) / 255f)      // B
                    }

                    inputBuffer.putFloat(value)
                }
            }
        }

        val output = Array(1) {
            Array(numPredictions) {
                FloatArray(5 + numClasses)
            }
        }

        interpreter.run(inputBuffer, output)

        return postProcess(output[0], bitmap.width, bitmap.height)
    }

    private fun postProcess(
        predictions: Array<FloatArray>,
        originalWidth: Int,
        originalHeight: Int
    ): List<Detection> {

        val detections = mutableListOf<Detection>()

        for (i in predictions.indices) {

            val pred = predictions[i]

            val cx = pred[0]
            val cy = pred[1]
            val w = pred[2]
            val h = pred[3]

            val objectness = sigmoid(pred[4])

            var bestClass = -1
            var bestClassScore = 0f

            for (c in 0 until numClasses) {
                val classScore = sigmoid(pred[5 + c])
                if (classScore > bestClassScore) {
                    bestClassScore = classScore
                    bestClass = c
                }
            }

            val confidence = objectness * bestClassScore

            if (confidence < confThreshold) continue

            val x1 = (cx - w / 2f) * originalWidth / inputSize
            val y1 = (cy - h / 2f) * originalHeight / inputSize
            val x2 = (cx + w / 2f) * originalWidth / inputSize
            val y2 = (cy + h / 2f) * originalHeight / inputSize

            detections.add(
                Detection(
                    classId = bestClass,
                    score = confidence,
                    box = RectF(x1, y1, x2, y2)
                )
            )
        }

        return classAwareNMS(detections)
    }

    private fun classAwareNMS(detections: List<Detection>): List<Detection> {

        val finalDetections = mutableListOf<Detection>()

        for (classId in 0 until numClasses) {

            val classDetections = detections
                .filter { it.classId == classId }
                .sortedByDescending { it.score }
                .toMutableList()

            while (classDetections.isNotEmpty()) {

                val best = classDetections.removeAt(0)
                finalDetections.add(best)

                val iterator = classDetections.iterator()

                while (iterator.hasNext()) {
                    val other = iterator.next()
                    if (iou(best.box, other.box) > nmsThreshold) {
                        iterator.remove()
                    }
                }
            }
        }

        return finalDetections
    }

    private fun iou(a: RectF, b: RectF): Float {

        val left = max(a.left, b.left)
        val top = max(a.top, b.top)
        val right = min(a.right, b.right)
        val bottom = min(a.bottom, b.bottom)

        val intersection =
            max(0f, right - left) * max(0f, bottom - top)

        val areaA = (a.right - a.left) * (a.bottom - a.top)
        val areaB = (b.right - b.left) * (b.bottom - b.top)

        val union = areaA + areaB - intersection

        return if (union <= 0f) 0f else intersection / union
    }

    private fun sigmoid(x: Float): Float {
        return (1f / (1f + exp(-x)))
    }
}
