import json
import os

ANN_DIR = "dataset/annotations"

train_json = os.path.join(ANN_DIR, "instances_train2017.json")
val_json = os.path.join(ANN_DIR, "instances_val2017.json")


def analyze_coco(json_path, name):
    print(f"\n📊 Analyzing {name}...")

    with open(json_path, "r") as f:
        data = json.load(f)

    num_images = len(data.get("images", []))
    num_annotations = len(data.get("annotations", []))
    num_categories = len(data.get("categories", []))

    print(f"Images        : {num_images}")
    print(f"Annotations   : {num_annotations}")
    print(f"Categories    : {num_categories}")

    # Count annotations per category
    cat_count = {}
    for ann in data.get("annotations", []):
        cid = ann["category_id"]
        cat_count[cid] = cat_count.get(cid, 0) + 1

    print("\nAnnotations per category:")
    for cat in data.get("categories", []):
        cid = cat["id"]
        name = cat["name"]
        count = cat_count.get(cid, 0)
        print(f"  {name} ({cid}) : {count}")


# Run
analyze_coco(train_json, "Train")
analyze_coco(val_json, "Validation")
