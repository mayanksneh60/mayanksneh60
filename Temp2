import os
import json
import cv2

# Paths
IMG_DIR = "dataset/train2017"
ANN_PATH = "dataset/annotations/instances_train2017.json"

# Colors (BGR for OpenCV)
COLORS = {
    1: (0, 0, 255),    # Red - focused_edittext
    2: (0, 255, 0),    # Green - normal_edittext
    3: (255, 0, 0),    # Blue - textview
}

CLASS_NAMES = {
    1: "focused_edittext",
    2: "normal_edittext",
    3: "textview"
}

# Load COCO JSON
with open(ANN_PATH, "r") as f:
    data = json.load(f)

# Build image_id -> annotations map
ann_map = {}
for ann in data["annotations"]:
    img_id = ann["image_id"]
    ann_map.setdefault(img_id, []).append(ann)

# Loop over images
for img_info in data["images"]:
    img_id = img_info["id"]
    file_name = img_info["file_name"]
    img_path = os.path.join(IMG_DIR, file_name)

    if not os.path.exists(img_path):
        continue

    img = cv2.imread(img_path)

    # Draw boxes
    for ann in ann_map.get(img_id, []):
        x, y, w, h = ann["bbox"]
        category_id = ann["category_id"]

        color = COLORS.get(category_id, (255, 255, 255))
        label = CLASS_NAMES.get(category_id, "unknown")

        x1, y1 = int(x), int(y)
        x2, y2 = int(x + w), int(y + h)

        # Draw rectangle
        cv2.rectangle(img, (x1, y1), (x2, y2), color, 2)

        # Put label
        cv2.putText(
            img,
            label,
            (x1, y1 - 5),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            color,
            1,
            cv2.LINE_AA
        )

    # Show image
    cv2.imshow("Annotations", img)

    key = cv2.waitKey(0)
    if key == 27:  # ESC to exit
        break

cv2.destroyAllWindows()
