def resize_keep_aspect(img, max_w=720, max_h=1280):
    h, w = img.shape[:2]

    scale = min(max_w / w, max_h / h, 1.0)  # never upscale
    new_w = int(w * scale)
    new_h = int(h * scale)

    if scale < 1.0:
        img = cv2.resize(img, (new_w, new_h), interpolation=cv2.INTER_AREA)

    return img


