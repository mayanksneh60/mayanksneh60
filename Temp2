import torch
import argparse
from yolox.exp import get_exp
from yolox.utils import fuse_model

class YOLOXWithDecode(torch.nn.Module):
    def __init__(self, model):
        super().__init__()
        self.model = model
        self.model.head.decode_in_inference = True  # IMPORTANT

    def forward(self, x):
        outputs = self.model(x)
        return outputs


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-f", "--exp_file", type=str, required=True)
    parser.add_argument("-c", "--ckpt", type=str, required=True)
    parser.add_argument("--output-name", type=str, default="yolox_decode.onnx")
    parser.add_argument("--input-size", type=int, default=640)
    args = parser.parse_args()

    exp = get_exp(args.exp_file, None)
    model = exp.get_model()
    model.eval()

    # Load weights
    ckpt = torch.load(args.ckpt, map_location="cpu")
    model.load_state_dict(ckpt["model"])

    # Fuse Conv + BN
    model = fuse_model(model)

    # Wrap model with decode enabled
    model_with_decode = YOLOXWithDecode(model)
    model_with_decode.eval()

    dummy_input = torch.randn(1, 3, args.input_size, args.input_size)

    torch.onnx.export(
        model_with_decode,
        dummy_input,
        args.output_name,
        input_names=["images"],
        output_names=["output"],
        opset_version=12,
        dynamic_axes=None,
    )

    print("✅ Exported ONNX with decode included:", args.output_name)


if __name__ == "__main__":
    main()
