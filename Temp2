import pytesseract
from PIL import Image

image = Image.open("screenshot.png")

# Get OCR data as a dictionary
data = pytesseract.image_to_data(image, output_type=pytesseract.Output.DICT)

fields = {}
for i, text in enumerate(data['text']):
    if text.strip() != "" and int(data['conf'][i]) > 60:  # confidence threshold
        x1 = data['left'][i]                    # top-left X
        y1 = data['top'][i]                     # top-left Y
        x2 = x1 + data['width'][i]              # bottom-right X
        y2 = y1 + data['height'][i]             # bottom-right Y

        # Store as ((x1, y1), (x2, y2))
        fields[text] = ((x1, y1), (x2, y2))

print(fields)
