import torch
import cv2
import numpy as np
from PIL import Image
from transformers import AutoProcessor, AutoModelForZeroShotObjectDetection

MODEL_ID = "openmmlab-community/mm_grounding_dino_large_all"
IMAGE_PATH = "screenshot.png"
PROMPT = (
    "edit text input field. text box. input area. "
    "search box. username field. password field."
)

BOX_THRESHOLD = 0.35
TEXT_THRESHOLD = 0.25
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"

# Load
processor = AutoProcessor.from_pretrained(MODEL_ID)
model = AutoModelForZeroShotObjectDetection.from_pretrained(MODEL_ID).to(DEVICE)
model.eval()

image = Image.open(IMAGE_PATH).convert("RGB")
W, H = image.size

inputs = processor(images=image, text=PROMPT, return_tensors="pt").to(DEVICE)

with torch.no_grad():
    outputs = model(**inputs)

# ---------------------------------------------------
# MANUAL POST-PROCESSING (THE FIX)
# ---------------------------------------------------

logits = outputs.logits.sigmoid()[0]      # (num_queries, vocab)
boxes  = outputs.pred_boxes[0]            # (num_queries, 4) in cx,cy,w,h

# Get max score per query
scores, _ = logits.max(dim=1)

keep = scores > BOX_THRESHOLD
boxes = boxes[keep]
scores = scores[keep]

# Convert cx,cy,w,h → x1,y1,x2,y2
cx, cy, w, h = boxes.unbind(1)

x1 = (cx - 0.5 * w) * W
y1 = (cy - 0.5 * h) * H
x2 = (cx + 0.5 * w) * W
y2 = (cy + 0.5 * h) * H

boxes_xyxy = torch.stack([x1, y1, x2, y2], dim=1)

# Clamp
boxes_xyxy[:, 0::2].clamp_(0, W)
boxes_xyxy[:, 1::2].clamp_(0, H)

# ---------------------------------------------------
# RESULTS
# ---------------------------------------------------

detections = []
for box, score in zip(boxes_xyxy, scores):
    detections.append({
        "bbox": [int(v) for v in box.tolist()],
        "confidence": float(score)
    })

print("Detected EditText boxes:")
for d in detections:
    print(d)

# ---------------------------------------------------
# OPTIONAL VISUALIZATION
# ---------------------------------------------------

img = cv2.cvtColor(np.array(image), cv2.COLOR_RGB2BGR)
for d in detections:
    x1, y1, x2, y2 = d["bbox"]
    cv2.rectangle(img, (x1, y1), (x2, y2), (0,255,0), 2)

cv2.imshow("EditText Detection", img)
cv2.waitKey(0)
cv2.destroyAllWindows()
