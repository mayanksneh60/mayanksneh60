import torch
from yolox.exp import get_exp
from yolox.utils import fuse_model

# ==========================
# 🔧 EDIT THESE 3 PATHS ONLY
# ==========================

EXP_FILE = "exps/example/custom/yolox_s.py"   # your exp file
CKPT_FILE = "best_ckpt.pth"                   # your trained weights
OUTPUT_ONNX = "yolox_decode.onnx"             # output name
INPUT_SIZE = 640                              # your training size

# ==========================


class YOLOXWithDecode(torch.nn.Module):
    def __init__(self, model):
        super().__init__()
        self.model = model

        # 🔥 FORCE decode inside graph
        self.model.head.decode_in_inference = True

    def forward(self, x):
        outputs = self.model(x)
        return outputs


def main():

    print("🔹 Loading experiment...")
    exp = get_exp(EXP_FILE, None)

    model = exp.get_model()
    model.eval()

    print("🔹 Loading checkpoint...")
    ckpt = torch.load(CKPT_FILE, map_location="cpu")
    model.load_state_dict(ckpt["model"])

    print("🔹 Fusing model...")
    model = fuse_model(model)

    print("🔹 Wrapping model with decode...")
    model_with_decode = YOLOXWithDecode(model)
    model_with_decode.eval()

    dummy_input = torch.randn(1, 3, INPUT_SIZE, INPUT_SIZE)

    print("🔹 Exporting ONNX with decode included...")
    torch.onnx.export(
        model_with_decode,
        dummy_input,
        OUTPUT_ONNX,
        input_names=["images"],
        output_names=["output"],
        opset_version=12,
        dynamic_axes=None,
    )

    print("✅ SUCCESS: ONNX exported with decode included")
    print("📦 Saved as:", OUTPUT_ONNX)


if __name__ == "__main__":
    main()
