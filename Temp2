import os
import cv2
from ultralytics import YOLO

# paths
model_path = "best.pt"
image_folder = "yolo_dataset/images/val"  # change if needed

# load model
model = YOLO(model_path)

# supported image extensions
IMAGE_EXTS = (".jpg", ".jpeg", ".png")

image_files = [
    os.path.join(image_folder, f)
    for f in sorted(os.listdir(image_folder))
    if f.lower().endswith(IMAGE_EXTS)
]

print(f"Found {len(image_files)} images")

for img_path in image_files:
    print(f"Inferencing: {img_path}")

    # run inference
    results = model(img_path, conf=0.15)

    # read image
    img = cv2.imread(img_path)

    # draw boxes
    for r in results:
        if r.boxes is None:
            continue

        for box in r.boxes:
            x1, y1, x2, y2 = map(int, box.xyxy[0])
            conf = float(box.conf[0])

            label = f"TEXT_INPUT {conf:.2f}"

            cv2.rectangle(img, (x1, y1), (x2, y2), (0, 255, 0), 2)
            cv2.putText(
                img,
                label,
                (x1, max(y1 - 8, 0)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.5,
                (0, 255, 0),
                1,
                cv2.LINE_AA,
            )

    cv2.imshow("YOLO TEXT_INPUT Inference", img)

    key = cv2.waitKey(0) & 0xFF

    # exit conditions
    if key == ord("q") or key == 27:  # 'q' or ESC
        print("Exiting inference loop")
        break

cv2.destroyAllWindows()
