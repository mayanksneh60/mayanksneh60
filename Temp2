import cv2
import numpy as np
import tensorflow as tf

def sigmoid(x):
    return 1 / (1 + np.exp(-np.clip(x, -20, 20)))

def pre_process(image, input_size=(640, 640)):
    # YOLOX standard: Letterbox resize to 640x640 with 114 padding
    padded_img = np.ones((input_size[0], input_size[1], 3), dtype=np.uint8) * 114
    r = min(input_size[0] / image.shape[0], input_size[1] / image.shape[1])
    resized_img = cv2.resize(image, (int(image.shape[1] * r), int(image.shape[0] * r)))
    padded_img[:int(image.shape[0] * r), :int(image.shape[1] * r)] = resized_img
    # Convert HWC to CHW and normalize 0-1
    padded_img = padded_img.transpose((2, 0, 1))
    return np.ascontiguousarray(padded_img, dtype=np.float32) / 255.0, r

def decode_yolox(output, input_size=(640, 640)):
    # Standard YOLOX strides for 8400 proposals
    strides = [8, 16, 32]
    grids = []
    expanded_strides = []

    for stride in strides:
        hsize, wsize = input_size[0] // stride, input_size[1] // stride
        grid_y, grid_x = np.meshgrid(np.arange(hsize), np.arange(wsize))
        grid = np.stack((grid_x, grid_y), axis=-1).reshape(-1, 2)
        grids.append(grid)
        expanded_strides.append(np.full((grid.shape[0], 1), stride))

    grids = np.concatenate(grids, axis=0)
    expanded_strides = np.concatenate(expanded_strides, axis=0)

    # Decode Box math: (grid + offset) * stride
    # Note: Your raw values suggest the model might already have some scaling, 
    # but we follow the standard YOLOX decoding here.
    output[..., :2] = (output[..., :2] + grids) * expanded_strides
    output[..., 2:4] = np.exp(np.clip(output[..., 2:4], -10, 10)) * expanded_strides
    
    # Center to Corner
    output[..., 0] = output[..., 0] - output[..., 2] / 2
    output[..., 1] = output[..., 1] - output[..., 3] / 2
    # Width/Height to Corner 2
    output[..., 2] = output[..., 0] + output[..., 2]
    output[..., 3] = output[..., 1] + output[..., 3]
    return output

def run_inference(model_path, image_path):
    interpreter = tf.lite.Interpreter(model_path=model_path)
    interpreter.allocate_tensors()
    input_idx = interpreter.get_input_details()[0]['index']
    output_idx = interpreter.get_output_details()[0]['index']

    img = cv2.imread(image_path)
    if img is None: return
    h_orig, w_orig = img.shape[:2]
    input_data, ratio = pre_process(img)
    
    interpreter.set_tensor(input_idx, [input_data])
    interpreter.invoke()
    raw_output = interpreter.get_tensor(output_idx)[0]

    # APPLY SIGMOID to Objectness and Class probabilities
    raw_output[..., 4:] = sigmoid(raw_output[..., 4:])
    
    predictions = decode_yolox(raw_output)

    # Score = Obj_conf * Max_Class_conf
    scores = predictions[:, 4] * np.max(predictions[:, 5:], axis=1)
    class_ids = np.argmax(predictions[:, 5:], axis=1)

    # Filtering - Start with 0.1 to see what we find
    mask = scores > 0.1
    boxes = predictions[mask, :4] / ratio
    confidences = scores[mask]
    classes = class_ids[mask]

    print(f"Detections found: {len(boxes)}")
    class_names = ["focused_edittext", "normal_edittext"]

    for i in range(len(boxes)):
        x1, y1, x2, y2 = np.clip(boxes[i], 0, [w_orig, h_orig, w_orig, h_orig]).astype(int)
        
        # Draw
        label = f"{class_names[classes[i]]} {confidences[i]:.2f}"
        color = (0, 0, 255) if classes[i] == 0 else (0, 255, 0)
        cv2.rectangle(img, (x1, y1), (x2, y2), color, 2)
        cv2.putText(img, label, (x1, y1-10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)
        print(f"Found: {label} at {x1, y1, x2, y2}")

    cv2.imshow("Final YOLOX Result", img)
    cv2.waitKey(0)

if __name__ == "__main__":
    run_inference("best_ckpt_yolox_200epoch_mllm_all_neg.tflite", "test.jpg")
