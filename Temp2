import android.graphics.Bitmap
import android.graphics.RectF
import org.tensorflow.lite.Interpreter
import java.nio.ByteBuffer
import java.nio.ByteOrder
import kotlin.math.max
import kotlin.math.min

data class Detection(
    val classId: Int,
    val score: Float,
    val box: RectF
)

class YoloxTFLite(
    private val interpreter: Interpreter,
    private val inputSize: Int = 640,
    private val numClasses: Int = 2,
    private val confThreshold: Float = 0.3f,
    private val nmsThreshold: Float = 0.45f
) {

    fun detect(bitmap: Bitmap): List<Detection> {

        val originalW = bitmap.width
        val originalH = bitmap.height

        val resized = Bitmap.createScaledBitmap(bitmap, inputSize, inputSize, true)

        val inputBuffer =
            ByteBuffer.allocateDirect(1 * 3 * inputSize * inputSize * 4)
        inputBuffer.order(ByteOrder.nativeOrder())
        inputBuffer.rewind()

        // NCHW format
        for (c in 0 until 3) {
            for (y in 0 until inputSize) {
                for (x in 0 until inputSize) {

                    val pixel = resized.getPixel(x, y)

                    val value = when (c) {
                        0 -> ((pixel shr 16 and 0xFF) / 255f)
                        1 -> ((pixel shr 8 and 0xFF) / 255f)
                        else -> ((pixel and 0xFF) / 255f)
                    }

                    inputBuffer.putFloat(value)
                }
            }
        }

        val output =
            Array(1) { Array(8400) { FloatArray(5 + numClasses) } }

        interpreter.run(inputBuffer, output)

        return postProcess(
            output[0],
            originalW,
            originalH
        )
    }

    private fun postProcess(
        predictions: Array<FloatArray>,
        originalW: Int,
        originalH: Int
    ): List<Detection> {

        val detections = mutableListOf<Detection>()

        val scaleX = originalW / inputSize.toFloat()
        val scaleY = originalH / inputSize.toFloat()

        for (pred in predictions) {

            var x1 = pred[0]
            var y1 = pred[1]
            var x2 = pred[2]
            var y2 = pred[3]
            val obj = pred[4]

            // Skip invalid boxes
            if (!x1.isFinite() || !y1.isFinite() ||
                !x2.isFinite() || !y2.isFinite()
            ) continue

            var bestClass = -1
            var bestScore = 0f

            for (c in 0 until numClasses) {
                val score = obj * pred[5 + c]
                if (score > bestScore) {
                    bestScore = score
                    bestClass = c
                }
            }

            if (bestScore < confThreshold) continue

            // Scale back to original image
            x1 *= scaleX
            y1 *= scaleY
            x2 *= scaleX
            y2 *= scaleY

            // Clamp to image bounds
            x1 = max(0f, min(x1, originalW.toFloat()))
            y1 = max(0f, min(y1, originalH.toFloat()))
            x2 = max(0f, min(x2, originalW.toFloat()))
            y2 = max(0f, min(y2, originalH.toFloat()))

            if (x2 <= x1 || y2 <= y1) continue

            detections.add(
                Detection(
                    classId = bestClass,
                    score = bestScore,
                    box = RectF(x1, y1, x2, y2)
                )
            )
        }

        return classAwareNMS(detections)
    }

    private fun classAwareNMS(
        detections: List<Detection>
    ): List<Detection> {

        val finalDetections = mutableListOf<Detection>()

        for (classId in 0 until numClasses) {

            val classDetections = detections
                .filter { it.classId == classId }
                .sortedByDescending { it.score }
                .toMutableList()

            while (classDetections.isNotEmpty()) {

                val best = classDetections.removeAt(0)
                finalDetections.add(best)

                val iterator = classDetections.iterator()

                while (iterator.hasNext()) {
                    val other = iterator.next()
                    if (iou(best.box, other.box) > nmsThreshold) {
                        iterator.remove()
                    }
                }
            }
        }

        return finalDetections
    }

    private fun iou(a: RectF, b: RectF): Float {

        val left = max(a.left, b.left)
        val top = max(a.top, b.top)
        val right = min(a.right, b.right)
        val bottom = min(a.bottom, b.bottom)

        val intersection =
            max(0f, right - left) *
                    max(0f, bottom - top)

        val areaA = (a.right - a.left) *
                (a.bottom - a.top)

        val areaB = (b.right - b.left) *
                (b.bottom - b.top)

        val union = areaA + areaB - intersection

        return if (union <= 0f) 0f
        else intersection / union
    }
}
