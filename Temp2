import csv
import os
import shutil

# ---- CONFIG ----
csv_path = "path/to/your.csv"
source_folder = "path/to/source_images"
destination_folder = "path/to/destination_images"

# Create destination folder if not exists
os.makedirs(destination_folder, exist_ok=True)

unique_images = set()

# ---- READ CSV ----
with open(csv_path, newline='', encoding='utf-8') as file:
    reader = csv.DictReader(file)
    for row in reader:
        img_name = row["image_name"].strip()
        unique_images.add(img_name)

print(f"Total unique images to copy: {len(unique_images)}")

# ---- COPY FILES ----
for img in unique_images:
    src = os.path.join(source_folder, img)
    dst = os.path.join(destination_folder, img)

    if os.path.exists(src):
        shutil.copy(src, dst)
    else:
        print(f"Missing image (skipped): {img}")

print("Copying complete.")
