import os
import json
import shutil
from PIL import Image
from tqdm import tqdm

INPUT_ROOT = "dataset"
OUTPUT_ROOT = "dataset_rtdetr"

CLASS_NAMES = ["edit_text_normal", "edit_text_focused"]


def convert_split(split):

    img_dir = os.path.join(INPUT_ROOT, "images", split)
    label_dir = os.path.join(INPUT_ROOT, "labels", split)

    out_img_dir = os.path.join(OUTPUT_ROOT, f"{split}2017")
    os.makedirs(out_img_dir, exist_ok=True)

    images = []
    annotations = []

    image_id = 1
    ann_id = 1

    for img_file in tqdm(os.listdir(img_dir)):

        if not img_file.lower().endswith((".jpg", ".png", ".jpeg")):
            continue

        img_path = os.path.join(img_dir, img_file)
        label_path = os.path.join(label_dir, os.path.splitext(img_file)[0] + ".txt")

        img = Image.open(img_path)
        width, height = img.size

        images.append({
            "id": image_id,
            "file_name": img_file,
            "width": width,
            "height": height
        })

        shutil.copy(img_path, os.path.join(out_img_dir, img_file))

        if os.path.exists(label_path):

            with open(label_path) as f:
                lines = f.readlines()

            for line in lines:

                parts = line.strip().split()

                if len(parts) != 5:
                    continue

                cls, x, y, w, h = map(float, parts)

                x_center = x * width
                y_center = y * height
                bw = w * width
                bh = h * height

                x_min = x_center - bw / 2
                y_min = y_center - bh / 2

                annotations.append({
                    "id": ann_id,
                    "image_id": image_id,
                    "category_id": int(cls),
                    "bbox": [
                        round(x_min, 4),
                        round(y_min, 4),
                        round(bw, 4),
                        round(bh, 4)
                    ],
                    "area": round(bw * bh, 4),
                    "iscrowd": 0
                })

                ann_id += 1

        image_id += 1

    categories = []

    for i, name in enumerate(CLASS_NAMES):
        categories.append({
            "id": i,
            "name": name
        })

    coco = {
        "images": images,
        "annotations": annotations,
        "categories": categories
    }

    os.makedirs(os.path.join(OUTPUT_ROOT, "annotations"), exist_ok=True)

    out_json = os.path.join(
        OUTPUT_ROOT,
        "annotations",
        f"instances_{split}2017.json"
    )

    with open(out_json, "w") as f:
        json.dump(coco, f)

    print(f"{split} dataset converted")
    print("Images:", len(images))
    print("Annotations:", len(annotations))


def main():

    convert_split("train")
    convert_split("val")

    print("Conversion complete")
    print("Output dataset:", OUTPUT_ROOT)


if __name__ == "__main__":
    main()
