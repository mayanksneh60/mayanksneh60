import os
import shutil
import json

# paths
input_dataset = "dataset"
output_dataset = "rf_detr_dataset"

train_images = os.path.join(input_dataset, "train2017")
val_images = os.path.join(input_dataset, "val2017")

train_ann = os.path.join(input_dataset, "annotations", "instances_train2017.json")
val_ann = os.path.join(input_dataset, "annotations", "instances_val2017.json")

# output folders
train_out = os.path.join(output_dataset, "train")
valid_out = os.path.join(output_dataset, "valid")
test_out = os.path.join(output_dataset, "test")

os.makedirs(train_out, exist_ok=True)
os.makedirs(valid_out, exist_ok=True)
os.makedirs(test_out, exist_ok=True)


def copy_images(src, dst):
    for file in os.listdir(src):
        src_file = os.path.join(src, file)
        dst_file = os.path.join(dst, file)
        if os.path.isfile(src_file):
            shutil.copy(src_file, dst_file)


# copy images
print("Copying train images...")
copy_images(train_images, train_out)

print("Copying validation images...")
copy_images(val_images, valid_out)

# copy annotation files
shutil.copy(train_ann, os.path.join(train_out, "_annotations.coco.json"))
shutil.copy(val_ann, os.path.join(valid_out, "_annotations.coco.json"))

# create empty test annotation file
empty_test = {
    "images": [],
    "annotations": [],
    "categories": []
}

# copy categories from train json
with open(train_ann) as f:
    data = json.load(f)
    empty_test["categories"] = data["categories"]

with open(os.path.join(test_out, "_annotations.coco.json"), "w") as f:
    json.dump(empty_test, f)

print("RF-DETR dataset created successfully!")
