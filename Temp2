import pandas as pd

# Load CSVs
csv1 = pd.read_csv("csv1.csv")
csv2 = pd.read_csv("csv2.csv")

# Keep only required columns from csv1
lookup = csv1[["image_name", "screen_width", "screen_height"]]

# Merge on image_name
merged = csv2.merge(
    lookup,
    on="image_name",
    how="left",
    suffixes=("", "_from_csv1")
)

# Populate missing values
merged["screen_width"] = merged["screen_width"].fillna(merged["screen_width_from_csv1"])
merged["screen_height"] = merged["screen_height"].fillna(merged["screen_height_from_csv1"])

# Drop helper columns
merged.drop(columns=["screen_width_from_csv1", "screen_height_from_csv1"], inplace=True)

# Save output
merged.to_csv("csv2_updated.csv", index=False)

print("✅ csv2_updated.csv created successfully")
