python - <<EOF
import json

with open("annotations/instances_train2017.json") as f:
    data = json.load(f)

images_with_ann = set([ann["image_id"] for ann in data["annotations"]])

print("Images with annotations:", len(images_with_ann))
print("Total images:", len(data["images"]))
print("Images without annotations:", len(data["images"]) - len(images_with_ann))
EOF
