import pandas as pd

# Load CSVs
csv1 = pd.read_csv("csv1.csv")
csv2 = pd.read_csv("csv2.csv")

# Deduplicate csv1: keep first screen size per image_name
lookup = (
    csv1[["image_name", "screen_width", "screen_height"]]
    .drop_duplicates(subset="image_name")
)

# Merge (one-to-one)
merged = csv2.merge(
    lookup,
    on="image_name",
    how="left"
)

# Save result
merged.to_csv("csv2_updated.csv", index=False)

print(f"Rows in csv2: {len(csv2)}")
print(f"Rows after update: {len(merged)}")
