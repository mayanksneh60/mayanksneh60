import csv
import os
import shutil
import random
from collections import defaultdict

# paths
csv_path = "yolo_text_input_clean.csv"
source_image_dir = "images_text_input"

output_root = "yolo_dataset"
train_ratio = 0.9  # 90% train, 10% val
random.seed(42)

# output dirs
for split in ["train", "val"]:
    os.makedirs(os.path.join(output_root, "images", split), exist_ok=True)
    os.makedirs(os.path.join(output_root, "labels", split), exist_ok=True)

# read CSV and group by image
annotations = defaultdict(list)

with open(csv_path, "r", encoding="utf-8") as f:
    reader = csv.DictReader(f)
    for row in reader:
        image_name = row["image_name"]
        class_id = row["class_id"]

        x_center = row["x_center"]
        y_center = row["y_center"]
        width = row["width"]
        height = row["height"]

        annotations[image_name].append(
            f"{class_id} {x_center} {y_center} {width} {height}"
        )

# split images
image_list = list(annotations.keys())
random.shuffle(image_list)

split_idx = int(len(image_list) * train_ratio)
train_images = set(image_list[:split_idx])
val_images = set(image_list[split_idx:])

def process_split(split_name, image_set):
    for image_name in image_set:
        # copy image
        src_img = os.path.join(source_image_dir, image_name)
        dst_img = os.path.join(output_root, "images", split_name, image_name)
        shutil.copy2(src_img, dst_img)

        # write label file
        label_name = os.path.splitext(image_name)[0] + ".txt"
        label_path = os.path.join(output_root, "labels", split_name, label_name)

        with open(label_path, "w") as f:
            f.write("\n".join(annotations[image_name]))

process_split("train", train_images)
process_split("val", val_images)

print("YOLO dataset created successfully!")
print(f"Train images: {len(train_images)}")
print(f"Val images  : {len(val_images)}")
