import cv2
import numpy as np
import tensorflow as tf
import matplotlib.pyplot as plt

# ==========================
# CONFIG
# ==========================
MODEL_PATH = "yolox.tflite"
IMAGE_PATH = "test.jpg"

INPUT_SIZE = (640, 640)
NUM_CLASSES = 2
CONF_THRESHOLD = 0.3
NMS_THRESHOLD = 0.45

CLASS_NAMES = ["normal_edit_text", "focused_edit_text"]


# ==========================
# LOAD MODEL
# ==========================
print("Loading TFLite model...")
interpreter = tf.lite.Interpreter(model_path=MODEL_PATH)
interpreter.allocate_tensors()

input_details = interpreter.get_input_details()
output_details = interpreter.get_output_details()

print("\n=== MODEL INPUT DETAILS ===")
print(input_details)

print("\n=== MODEL OUTPUT DETAILS ===")
print(output_details)


# ==========================
# LOAD & PREPROCESS IMAGE
# ==========================
print("\nLoading image...")
image = cv2.imread(IMAGE_PATH)
if image is None:
    raise ValueError("Image not found!")

original_image = image.copy()
orig_h, orig_w = image.shape[:2]

print(f"Original image shape: {image.shape}")

image_resized = cv2.resize(image, INPUT_SIZE)
image_rgb = cv2.cvtColor(image_resized, cv2.COLOR_BGR2RGB)
image_input = image_rgb.astype(np.float32)

# Normalize (YOLOX usually expects 0-1 or raw float — we print to verify)
image_input /= 255.0

# Add batch dimension
image_input = np.expand_dims(image_input, axis=0)

print(f"Input tensor shape after preprocessing: {image_input.shape}")
print(f"Input dtype: {image_input.dtype}")
print(f"Min pixel: {image_input.min()}, Max pixel: {image_input.max()}")

# ==========================
# RUN INFERENCE
# ==========================
print("\nRunning inference...")
interpreter.set_tensor(input_details[0]['index'], image_input)
interpreter.invoke()

output_data = interpreter.get_tensor(output_details[0]['index'])

print("\n=== RAW OUTPUT ===")
print("Output shape:", output_data.shape)
print("Output dtype:", output_data.dtype)
print("Output min:", np.min(output_data))
print("Output max:", np.max(output_data))


# ==========================
# POST PROCESSING (YOLOX style)
# ==========================
print("\nPostprocessing...")

predictions = output_data[0]  # remove batch dimension
print("Predictions shape:", predictions.shape)

boxes = []
scores = []
class_ids = []

for pred in predictions:
    obj_score = pred[4]
    class_scores = pred[5:]

    class_id = np.argmax(class_scores)
    class_score = class_scores[class_id]

    score = obj_score * class_score

    if score > CONF_THRESHOLD:
        cx, cy, w, h = pred[0:4]

        # Convert from center to corner format
        x1 = cx - w / 2
        y1 = cy - h / 2
        x2 = cx + w / 2
        y2 = cy + h / 2

        boxes.append([x1, y1, x2, y2])
        scores.append(float(score))
        class_ids.append(class_id)

print(f"Boxes before NMS: {len(boxes)}")

# Apply NMS
indices = cv2.dnn.NMSBoxes(
    boxes,
    scores,
    CONF_THRESHOLD,
    NMS_THRESHOLD
)

print(f"Boxes after NMS: {len(indices)}")

# ==========================
# DRAW BOXES
# ==========================
if len(indices) > 0:
    for i in indices.flatten():
        x1, y1, x2, y2 = boxes[i]

        # Scale back to original image size
        x1 = int(x1 * orig_w / INPUT_SIZE[0])
        y1 = int(y1 * orig_h / INPUT_SIZE[1])
        x2 = int(x2 * orig_w / INPUT_SIZE[0])
        y2 = int(y2 * orig_h / INPUT_SIZE[1])

        class_id = class_ids[i]
        score = scores[i]

        label = f"{CLASS_NAMES[class_id]}: {score:.2f}"

        cv2.rectangle(original_image, (x1, y1), (x2, y2), (0, 255, 0), 2)
        cv2.putText(original_image, label,
                    (x1, y1 - 10),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    (0, 255, 0),
                    2)

else:
    print("⚠ No detections found. Possible reasons:")
    print("1. Confidence threshold too high")
    print("2. Output format different (needs decode)")
    print("3. Model expects non-normalized input")
    print("4. Anchor/grid decoding missing")

# ==========================
# DISPLAY IMAGE
# ==========================
plt.figure(figsize=(10, 10))
plt.imshow(cv2.cvtColor(original_image, cv2.COLOR_BGR2RGB))
plt.axis("off")
plt.show()
