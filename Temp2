import os
import json
from paddleocr import PaddleOCR
from tqdm import tqdm

DATASET_DIR = "dataset"
OUTPUT_JSON = "text_coco.json"

ocr = PaddleOCR(use_angle_cls=False, rec=False)

coco = {
    "images": [],
    "annotations": [],
    "categories": [
        {"id": 1, "name": "text"}
    ]
}

image_id = 0
annotation_id = 0


def process_image(img_path):
    results = ocr.ocr(img_path, det=True, rec=False)

    boxes = []

    for line in results:
        box = line[0]

        x_coords = [p[0] for p in box]
        y_coords = [p[1] for p in box]

        x_min = int(min(x_coords))
        y_min = int(min(y_coords))
        x_max = int(max(x_coords))
        y_max = int(max(y_coords))

        w = x_max - x_min
        h = y_max - y_min

        # filter noise
        if w < 10 or h < 10:
            continue

        boxes.append([x_min, y_min, w, h])

    return boxes


for root, _, files in os.walk(DATASET_DIR):
    for fname in tqdm(files):
        if not fname.lower().endswith(".jpg"):
            continue

        img_path = os.path.join(root, fname)

        try:
            boxes = process_image(img_path)

            # Add image entry
            coco["images"].append({
                "id": image_id,
                "file_name": os.path.relpath(img_path, DATASET_DIR),
                "width": 0,   # optional (fill if needed)
                "height": 0
            })

            # Add annotations
            for bbox in boxes:
                x, y, w, h = bbox

                coco["annotations"].append({
                    "id": annotation_id,
                    "image_id": image_id,
                    "category_id": 1,
                    "bbox": [x, y, w, h],
                    "area": w * h,
                    "iscrowd": 0
                })

                annotation_id += 1

            image_id += 1

        except Exception as e:
            print(f"Error processing {img_path}: {e}")


# Save JSON
with open(OUTPUT_JSON, "w") as f:
    json.dump(coco, f, indent=4)

print(f"COCO annotations saved to {OUTPUT_JSON}")
