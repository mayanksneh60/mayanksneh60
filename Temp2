    -o TrainDataset.dataset_dir=../Dataset_Root/ \
    -o TrainDataset.anno_path=annotations/train.json \
    -o TrainDataset.image_dir=images/train \
    -o EvalDataset.dataset_dir=../Dataset_Root/ \
    -o EvalDataset.anno_path=annotations/val.json \
    -o EvalDataset.image_dir=images/val \
    --eval




