private fun traverseAndLogViewNode(node: AssistStructure.ViewNode, depth: Int = 0) {
    val indent = " ".repeat(depth * 2)

    Log.d("AutofillDump", "${indent}ViewNode:")
    Log.d("AutofillDump", "${indent}  idEntry: ${node.idEntry}")
    Log.d("AutofillDump", "${indent}  idPackage: ${node.idPackage}")
    Log.d("AutofillDump", "${indent}  idType: ${node.idType}")
    Log.d("AutofillDump", "${indent}  className: ${node.className}")
    Log.d("AutofillDump", "${indent}  hint: ${node.hint}")
    Log.d("AutofillDump", "${indent}  text: ${node.text}")
    Log.d("AutofillDump", "${indent}  autofillHints: ${node.autofillHints?.joinToString()}")
    Log.d("AutofillDump", "${indent}  autofillType: ${node.autofillType}")
    Log.d("AutofillDump", "${indent}  autofillValue: ${node.autofillValue}")
    Log.d("AutofillDump", "${indent}  contentDescription: ${node.contentDescription}")
    Log.d("AutofillDump", "${indent}  htmlInfo: ${node.htmlInfo}")
    Log.d("AutofillDump", "${indent}  importantForAutofill: ${node.importantForAutofill}")
    Log.d("AutofillDump", "${indent}  inputType: ${node.inputType}")
    Log.d("AutofillDump", "${indent}  isEnabled: ${node.isEnabled}")
    Log.d("AutofillDump", "${indent}  isFocused: ${node.isFocused}")
    Log.d("AutofillDump", "${indent}  webDomain: ${node.webDomain}")
    Log.d("AutofillDump", "${indent}  webScheme: ${node.webScheme}")
    Log.d("AutofillDump", "${indent}  webDomain: ${node.webDomain}")
    Log.d("AutofillDump", "${indent}  url: ${node.webDomain}")

    // Dump extras if available
    node.extras?.let {
        Log.d("AutofillDump", "${indent}  extras: $it")
    }

    // Traverse children
    val childrenSize = node.childCount
    for (i in 0 until childrenSize) {
        traverseAndLogViewNode(node.getChildAt(i), depth + 1)
    }
}
