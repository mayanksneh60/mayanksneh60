def __getitem__(self, idx):
    sample = self.samples[idx]

    # ----- image -----
    image = Image.open(sample["image"]).convert("RGB")
    pixel_values = image_transform(image)

    # ----- target -----
    boxes = sample["boxes"]
    target_text = "; ".join(
        [f"[{b[0]:.3f},{b[1]:.3f},{b[2]:.3f},{b[3]:.3f}]" for b in boxes]
    )

    IMAGE_TOKEN_SIZE = 256
    IMAGE_TOKEN = tokenizer.image_token

    image_tokens = " ".join([IMAGE_TOKEN] * IMAGE_TOKEN_SIZE)

    prompt = (
        f"{image_tokens}\n"
        "Detect all edit text boxes and output normalized bounding boxes.\n"
        f"{target_text}"
    )

    inputs = tokenizer(prompt, return_tensors="pt", add_special_tokens=True)

    input_ids = inputs["input_ids"][0]
    attention_mask = inputs["attention_mask"][0]

    image_flags = torch.zeros_like(input_ids)
    image_flags[:IMAGE_TOKEN_SIZE] = 1

    # ----- asserts -----
    assert image_flags.shape == input_ids.shape
    assert image_flags.sum().item() == IMAGE_TOKEN_SIZE

    return {
        "input_ids": input_ids,
        "attention_mask": attention_mask,
        "pixel_values": pixel_values,
        "image_flags": image_flags,
    }
