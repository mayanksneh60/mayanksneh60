import os
import json
import shutil
from PIL import Image
from tqdm import tqdm

INPUT_ROOT = "dataset_clean"
OUTPUT_ROOT = "dataset_clean_fixed"

EXPECTED_CLASSES = 2
ROUND_DECIMALS = 4


def validate_bbox(bbox, img_w, img_h):

    x, y, w, h = bbox

    if w <= 0 or h <= 0:
        return None

    x2 = x + w
    y2 = y + h

    if x2 <= x or y2 <= y:
        return None

    if x < 0 or y < 0:
        return None

    if x2 > img_w or y2 > img_h:
        return None

    return [
        round(x, ROUND_DECIMALS),
        round(y, ROUND_DECIMALS),
        round(w, ROUND_DECIMALS),
        round(h, ROUND_DECIMALS)
    ]


def process_split(split):

    print(f"\nProcessing {split} dataset...")

    image_dir = os.path.join(INPUT_ROOT, split)
    ann_file = os.path.join(INPUT_ROOT, "annotations", f"instances_{split}.json")

    output_image_dir = os.path.join(OUTPUT_ROOT, split)
    os.makedirs(output_image_dir, exist_ok=True)

    with open(ann_file) as f:
        coco = json.load(f)

    images = {img["id"]: img for img in coco["images"]}
    annotations = coco["annotations"]
    categories = coco["categories"]

    class_ids = set([c["id"] for c in categories])

    print("Classes:", class_ids)
    print("Class Names:", [c["name"] for c in categories])

    if len(class_ids) != EXPECTED_CLASSES:
        raise Exception(f"Expected {EXPECTED_CLASSES} classes but found {len(class_ids)}")

    cleaned_annotations = []
    used_images = set()

    removed_boxes = 0
    removed_images = 0

    for ann in tqdm(annotations):

        image_id = ann["image_id"]

        if image_id not in images:
            removed_boxes += 1
            continue

        img_info = images[image_id]
        img_path = os.path.join(image_dir, img_info["file_name"])

        if not os.path.exists(img_path):
            removed_boxes += 1
            continue

        try:
            img = Image.open(img_path)
            img_w, img_h = img.size
        except:
            removed_boxes += 1
            continue

        bbox = validate_bbox(ann["bbox"], img_w, img_h)

        if bbox is None:
            removed_boxes += 1
            continue

        ann["bbox"] = bbox
        ann["area"] = round(bbox[2] * bbox[3], ROUND_DECIMALS)

        cleaned_annotations.append(ann)
        used_images.add(image_id)

    cleaned_images = []

    for img_id in tqdm(used_images):

        img = images[img_id]
        src = os.path.join(image_dir, img["file_name"])
        dst = os.path.join(output_image_dir, img["file_name"])

        if not os.path.exists(src):
            removed_images += 1
            continue

        shutil.copy(src, dst)
        cleaned_images.append(img)

    cleaned_dataset = {
        "images": cleaned_images,
        "annotations": cleaned_annotations,
        "categories": categories
    }

    os.makedirs(os.path.join(OUTPUT_ROOT, "annotations"), exist_ok=True)

    out_ann = os.path.join(OUTPUT_ROOT, "annotations", f"instances_{split}.json")

    with open(out_ann, "w") as f:
        json.dump(cleaned_dataset, f)

    print(f"\n{split} summary:")
    print("Valid Images:", len(cleaned_images))
    print("Valid Annotations:", len(cleaned_annotations))
    print("Removed Boxes:", removed_boxes)
    print("Removed Images:", removed_images)


def main():

    process_split("train2017")
    process_split("val2017")

    print("\nDataset cleaning finished.")
    print("Clean dataset saved at:", OUTPUT_ROOT)


if __name__ == "__main__":
    main()
