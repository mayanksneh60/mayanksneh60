import cv2
import numpy as np
import tensorflow as tf

def sigmoid(x):
    return 1 / (1 + np.exp(-np.clip(x, -20, 20)))

def nms(boxes, scores, threshold):
    """Pure NumPy Non-Maximum Suppression."""
    x1, y1, x2, y2 = boxes[:, 0], boxes[:, 1], boxes[:, 2], boxes[:, 3]
    areas = (x2 - x1) * (y2 - y1)
    order = scores.argsort()[::-1]
    keep = []
    while order.size > 0:
        i = order[0]
        keep.append(i)
        xx1 = np.maximum(x1[i], x1[order[1:]])
        yy1 = np.maximum(y1[i], y1[order[1:]])
        xx2 = np.minimum(x2[i], x2[order[1:]])
        yy2 = np.minimum(y2[i], y2[order[1:]])
        w = np.maximum(0.0, xx2 - xx1)
        h = np.maximum(0.0, yy2 - yy1)
        inter = w * h
        ovr = inter / (areas[i] + areas[order[1:]] - inter)
        inds = np.where(ovr <= threshold)[0]
        order = order[inds + 1]
    return keep

def decode_yolox(output, input_size=(640, 640)):
    strides = [8, 16, 32]
    grids, expanded_strides = [], []
    for stride in strides:
        hsize, wsize = input_size[0] // stride, input_size[1] // stride
        grid_y, grid_x = np.meshgrid(np.arange(hsize), np.arange(wsize))
        grid = np.stack((grid_x, grid_y), axis=-1).reshape(-1, 2)
        grids.append(grid)
        expanded_strides.append(np.full((grid.shape[0], 1), stride))
    grids = np.concatenate(grids, axis=0)
    expanded_strides = np.concatenate(expanded_strides, axis=0)

    # Box decoding
    output[..., :2] = (output[..., :2] + grids) * expanded_strides
    output[..., 2:4] = np.exp(np.clip(output[..., 2:4], -10, 10)) * expanded_strides
    # Convert center-xywh to corner-x1y1x2y2
    res = np.copy(output)
    res[..., 0] = output[..., 0] - output[..., 2] / 2
    res[..., 1] = output[..., 1] - output[..., 3] / 2
    res[..., 2] = output[..., 0] + output[..., 2] / 2
    res[..., 3] = output[..., 1] + output[..., 3] / 2
    return res

def run_inference(model_path, image_path):
    interpreter = tf.lite.Interpreter(model_path=model_path)
    interpreter.allocate_tensors()
    img = cv2.imread(image_path)
    h_orig, w_orig = img.shape[:2]
    
    # Pre-process
    input_size = (640, 640)
    r = min(input_size[0] / h_orig, input_size[1] / w_orig)
    resized = cv2.resize(img, (int(w_orig * r), int(h_orig * r)))
    padded = np.ones((input_size[0], input_size[1], 3), dtype=np.uint8) * 114
    padded[:resized.shape[0], :resized.shape[1]] = resized
    input_data = padded.transpose((2, 0, 1)).astype(np.float32) / 255.0

    interpreter.set_tensor(interpreter.get_input_details()[0]['index'], [input_data])
    interpreter.invoke()
    output = interpreter.get_tensor(interpreter.get_output_details()[0]['index'])[0]
    
    # Sigmoid + Decode
    output[..., 4:] = sigmoid(output[..., 4:])
    predictions = decode_yolox(output, input_size)

    # Filtering
    scores = predictions[:, 4] * np.max(predictions[:, 5:], axis=1)
    mask = scores > 0.35 # Use a slightly higher threshold to clean noise
    
    valid_boxes = predictions[mask, :4] / r
    valid_scores = scores[mask]
    valid_classes = np.argmax(predictions[mask, 5:], axis=1)

    if len(valid_boxes) > 0:
        # Run NMS to remove duplicates
        keep = nms(valid_boxes, valid_scores, 0.45)
        
        for i in keep:
            x1, y1, x2, y2 = np.clip(valid_boxes[i], 0, [w_orig, h_orig, w_orig, h_orig]).astype(int)
            
            # Final check: Don't draw boxes that cover the whole image
            if (x2 - x1) > (w_orig * 0.9) and (y2 - y1) > (h_orig * 0.9): continue
            
            label = f"Edittext {valid_scores[i]:.2f}"
            color = (0, 0, 255) if valid_classes[i] == 0 else (0, 255, 0)
            cv2.rectangle(img, (x1, y1), (x2, y2), color, 3)
            cv2.putText(img, label, (x1, y1-10), 0, 0.7, color, 2)

    cv2.imshow("Result", img)
    cv2.waitKey(0)

run_inference("best_ckpt_yolox_200epoch_mllm_all_neg.tflite", "test.jpg")
