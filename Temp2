package com.yourpackage.detector

import android.content.Context
import android.graphics.Bitmap
import android.graphics.RectF
import android.util.Log
import org.tensorflow.lite.Interpreter
import java.io.FileInputStream
import java.nio.ByteBuffer
import java.nio.ByteOrder
import java.nio.channels.FileChannel
import kotlin.math.exp
import kotlin.math.max
import kotlin.math.min

class YoloxTFLite(
    context: Context,
    modelPath: String
) {

    data class Detection(
        val box: RectF,
        val score: Float,
        val classId: Int
    )

    private val interpreter: Interpreter
    private val inputSize = 640
    private val numClasses = 2
    private val strides = intArrayOf(8, 16, 32)

    init {
        interpreter = Interpreter(loadModelFile(context, modelPath))
    }

    // ==============================
    // PUBLIC DETECT FUNCTION
    // ==============================
    fun detect(bitmap: Bitmap): List<Detection> {

        val resized = Bitmap.createScaledBitmap(bitmap, inputSize, inputSize, true)
        val input = preprocess(resized)

        val output = Array(1) { Array(8400) { FloatArray(5 + numClasses) } }

        interpreter.run(input, output)

        val detections = decode(output[0], bitmap.width, bitmap.height)

        return nms(detections, 0.45f)
    }

    // ==============================
    // PREPROCESS
    // ==============================
    private fun preprocess(bitmap: Bitmap): ByteBuffer {
        val buffer = ByteBuffer.allocateDirect(1 * 3 * inputSize * inputSize * 4)
        buffer.order(ByteOrder.nativeOrder())

        val intValues = IntArray(inputSize * inputSize)
        bitmap.getPixels(intValues, 0, inputSize, 0, 0, inputSize, inputSize)

        for (pixel in intValues) {
            val r = ((pixel shr 16) and 0xFF) / 255f
            val g = ((pixel shr 8) and 0xFF) / 255f
            val b = (pixel and 0xFF) / 255f

            buffer.putFloat(r)
            buffer.putFloat(g)
            buffer.putFloat(b)
        }

        buffer.rewind()
        return buffer
    }

    // ==============================
    // DECODE YOLOX OUTPUT
    // ==============================
    private fun decode(
        output: Array<FloatArray>,
        originalW: Int,
        originalH: Int
    ): MutableList<Detection> {

        val detections = mutableListOf<Detection>()
        val grids = generateGrids()

        for (i in 0 until 8400) {

            val tx = output[i][0]
            val ty = output[i][1]
            val tw = output[i][2]
            val th = output[i][3]
            val obj = sigmoid(output[i][4])

            val (gridX, gridY, stride) = grids[i]

            val cx = (tx + gridX) * stride
            val cy = (ty + gridY) * stride
            val w = exp(tw) * stride
            val h = exp(th) * stride

            val x1 = cx - w / 2f
            val y1 = cy - h / 2f
            val x2 = cx + w / 2f
            val y2 = cy + h / 2f

            var bestClass = 0
            var bestScore = 0f

            for (c in 0 until numClasses) {
                val classScore = sigmoid(output[i][5 + c])
                val score = obj * classScore
                if (score > bestScore) {
                    bestScore = score
                    bestClass = c
                }
            }

            if (bestScore > 0.3f) {

                // Scale back to original image
                val scaleX = originalW / inputSize.toFloat()
                val scaleY = originalH / inputSize.toFloat()

                val rect = RectF(
                    x1 * scaleX,
                    y1 * scaleY,
                    x2 * scaleX,
                    y2 * scaleY
                )

                detections.add(Detection(rect, bestScore, bestClass))
            }
        }

        return detections
    }

    // ==============================
    // GRID GENERATION
    // ==============================
    private fun generateGrids(): List<Triple<Int, Int, Int>> {

        val grids = mutableListOf<Triple<Int, Int, Int>>()

        for (stride in strides) {
            val numGrid = inputSize / stride

            for (y in 0 until numGrid) {
                for (x in 0 until numGrid) {
                    grids.add(Triple(x, y, stride))
                }
            }
        }

        return grids
    }

    // ==============================
    // NON MAX SUPPRESSION
    // ==============================
    private fun nms(
        detections: List<Detection>,
        iouThreshold: Float
    ): List<Detection> {

        val result = mutableListOf<Detection>()
        val sorted = detections.sortedByDescending { it.score }.toMutableList()

        while (sorted.isNotEmpty()) {
            val best = sorted.removeAt(0)
            result.add(best)

            sorted.removeAll {
                iou(best.box, it.box) > iouThreshold
            }
        }

        return result
    }

    private fun iou(a: RectF, b: RectF): Float {

        val areaA = (a.right - a.left) * (a.bottom - a.top)
        val areaB = (b.right - b.left) * (b.bottom - b.top)

        val left = max(a.left, b.left)
        val top = max(a.top, b.top)
        val right = min(a.right, b.right)
        val bottom = min(a.bottom, b.bottom)

        val intersection =
            max(0f, right - left) * max(0f, bottom - top)

        return intersection / (areaA + areaB - intersection + 1e-6f)
    }

    // ==============================
    // UTIL
    // ==============================
    private fun sigmoid(x: Float): Float {
        return 1f / (1f + exp(-x))
    }

    private fun loadModelFile(context: Context, modelPath: String): ByteBuffer {
        val fileDescriptor = context.assets.openFd(modelPath)
        val inputStream = FileInputStream(fileDescriptor.fileDescriptor)
        val fileChannel = inputStream.channel
        return fileChannel.map(
            FileChannel.MapMode.READ_ONLY,
            fileDescriptor.startOffset,
            fileDescriptor.declaredLength
        )
    }
}
