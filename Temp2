import json

file="annotations/instances_train2017.json"

with open(file) as f:
    data=json.load(f)

for ann in data["annotations"]:
    x,y,w,h=ann["bbox"]

    if w<=0 or h<=0:
        print("Invalid bbox:",ann)

    if ann["category_id"] not in [1,2]:
        print("Invalid category:",ann["category_id"])

print("done")
