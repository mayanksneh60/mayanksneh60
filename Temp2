import tensorflow as tf
import numpy as np

MODEL_PATH = "yolox_model.tflite"

# Load model
interpreter = tf.lite.Interpreter(model_path=MODEL_PATH)
interpreter.allocate_tensors()

print("\n===== MODEL DETAILS =====")

# Input details
input_details = interpreter.get_input_details()
print("\n--- INPUT DETAILS ---")
for inp in input_details:
    print("Name:", inp["name"])
    print("Shape:", inp["shape"])
    print("Dtype:", inp["dtype"])
    print("Quantization:", inp["quantization"])
    print("Index:", inp["index"])
    print()

# Output details
output_details = interpreter.get_output_details()
print("\n--- OUTPUT DETAILS ---")
for out in output_details:
    print("Name:", out["name"])
    print("Shape:", out["shape"])
    print("Dtype:", out["dtype"])
    print("Quantization:", out["quantization"])
    print("Index:", out["index"])
    print()

# All tensor details (optional)
print("\n--- TOTAL TENSORS ---")
print("Total tensors:", len(interpreter.get_tensor_details()))
