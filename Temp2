import os

label_dir = "labels"

classes = set()

for file in os.listdir(label_dir):
    if not file.endswith(".txt"):
        continue

    with open(os.path.join(label_dir, file)) as f:
        for line in f:
            cls = int(line.split()[0])
            classes.add(cls)

print("Classes found:", sorted(classes))
print("Max class id:", max(classes))
