import torch
import cv2
import numpy as np
from yolox.exp import get_exp
from yolox.utils import postprocess
from yolox.data.data_augment import ValTransform

# ==========================
# CONFIG
# ==========================
CKPT_PATH = "best_ckpt.pth"
EXP_FILE = "your_exp_file.py"   # your training exp file
IMAGE_PATH = "input.jpg"
CONF_THRE = 0.3
NMS_THRE = 0.45
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"

# ==========================
# LOAD MODEL
# ==========================
print("Loading YOLOX model...")

exp = get_exp(EXP_FILE, None)
model = exp.get_model()
model.to(DEVICE)
model.eval()

ckpt = torch.load(CKPT_PATH, map_location=DEVICE)
model.load_state_dict(ckpt["model"])
print("Model loaded successfully.")

# ==========================
# LOAD IMAGE
# ==========================
img = cv2.imread(IMAGE_PATH)
if img is None:
    raise ValueError("Image not found")

orig_h, orig_w = img.shape[:2]
print("Original image shape:", img.shape)

# Preprocess
preproc = ValTransform(legacy=False)
img_input, _ = preproc(img, None, exp.test_size)

img_input = torch.from_numpy(img_input).unsqueeze(0).float().to(DEVICE)

print("Input tensor shape:", img_input.shape)

# ==========================
# INFERENCE
# ==========================
with torch.no_grad():
    outputs = model(img_input)
    outputs = postprocess(
        outputs,
        exp.num_classes,
        CONF_THRE,
        NMS_THRE,
        class_agnostic=True
    )

# ==========================
# DRAW RESULTS
# ==========================
if outputs[0] is None:
    print("No detections.")
else:
    detections = outputs[0].cpu().numpy()
    print("Detections:", len(detections))

    for det in detections:
        x1, y1, x2, y2, obj_conf, class_conf, class_id = det
        score = obj_conf * class_conf

        # scale back to original size
        ratio = min(exp.test_size[0] / orig_h, exp.test_size[1] / orig_w)

        x1 /= ratio
        y1 /= ratio
        x2 /= ratio
        y2 /= ratio

        x1 = int(max(0, x1))
        y1 = int(max(0, y1))
        x2 = int(min(orig_w, x2))
        y2 = int(min(orig_h, y2))

        cv2.rectangle(img, (x1, y1), (x2, y2), (0,255,0), 2)
        cv2.putText(
            img,
            f"{score:.2f}",
            (x1, y1 - 5),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            (0,255,0),
            2
        )

cv2.imwrite("pytorch_result.jpg", img)
print("Saved result to pytorch_result.jpg")
