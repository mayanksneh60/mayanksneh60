import os
import csv
import torch
import pandas as pd
from PIL import Image
from torch.utils.data import Dataset, DataLoader
from torch.nn.utils.rnn import pad_sequence
from torchvision import transforms
from transformers import AutoTokenizer, AutoModelForCausalLM

# =============================
# CONFIG
# =============================
MODEL_PATH = "/path/to/InternVL3-78B"
IMAGE_ROOT = "/path/to/images"
CSV_PATH = "/path/to/annotations.csv"

DEVICE = "cuda"
BATCH_SIZE = 1
NUM_EPOCHS = 1
LR = 1e-5

# =============================
# LOAD MODEL + TOKENIZER
# =============================
tokenizer = AutoTokenizer.from_pretrained(
    MODEL_PATH,
    trust_remote_code=True
)

model = AutoModelForCausalLM.from_pretrained(
    MODEL_PATH,
    torch_dtype=torch.bfloat16,
    trust_remote_code=True,
    device_map="auto"
)

model.train()

MODEL_DTYPE = next(model.parameters()).dtype
print("Model dtype:", MODEL_DTYPE)

# =============================
# FREEZE VISION ENCODER (RECOMMENDED)
# =============================
for p in model.vision_model.parameters():
    p.requires_grad = False

# =============================
# IMAGE TRANSFORM (KEEP ASPECT RATIO)
# =============================
IMAGE_SIZE = 448

image_transform = transforms.Compose([
    transforms.Resize(
        IMAGE_SIZE,
        interpolation=transforms.InterpolationMode.BICUBIC
    ),
    transforms.CenterCrop(IMAGE_SIZE),
    transforms.ToTensor(),
    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225],
    )
])

# =============================
# GET IMAGE TOKEN LENGTH (CRITICAL)
# =============================
with torch.no_grad():
    dummy = torch.zeros(
        1, 3, IMAGE_SIZE, IMAGE_SIZE,
        device=DEVICE,
        dtype=MODEL_DTYPE
    )
    vit_embeds = model.extract_feature(dummy)
    IMAGE_TOKEN_LEN = vit_embeds.shape[1]

print("IMAGE_TOKEN_LEN =", IMAGE_TOKEN_LEN)
assert IMAGE_TOKEN_LEN > 0

# =============================
# LOAD & GROUP CSV
# =============================
df = pd.read_csv(CSV_PATH)

grouped = {}
for _, row in df.iterrows():
    grouped.setdefault(row.image_name, []).append(
        (row.x1, row.y1, row.x2, row.y2, row.screen_width, row.screen_height)
    )

# =============================
# DATASET
# =============================
class EditTextDataset(Dataset):
    def __init__(self, samples):
        self.samples = samples

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        sample = self.samples[idx]
        image_path = os.path.join(IMAGE_ROOT, sample["image"])

        image = Image.open(image_path).convert("RGB")
        pixel_values = image_transform(image)

        # ---- TEXT TARGET ----
        boxes = sample["boxes"]
        target_text = "; ".join(
            [f"[{b[0]:.3f},{b[1]:.3f},{b[2]:.3f},{b[3]:.3f}]" for b in boxes]
        )

        prompt = (
            "<image>\n"
            "Detect all edit text boxes and output normalized bounding boxes.\n"
            f"{target_text}"
        )

        inputs = tokenizer(
            prompt,
            return_tensors="pt",
            add_special_tokens=True
        )

        input_ids = inputs["input_ids"][0]
        attention_mask = inputs["attention_mask"][0]

        # ---- IMAGE FLAGS ----
        image_flags = torch.zeros_like(input_ids)

        image_token_id = tokenizer.convert_tokens_to_ids("<image>")
        image_pos = (input_ids == image_token_id).nonzero(as_tuple=False)[0].item()

        start = image_pos + 1
        end = start + IMAGE_TOKEN_LEN

        assert end <= input_ids.shape[0], "Not enough tokens for image patches"

        image_flags[start:end] = 1

        # ---- ASSERTS (VERY IMPORTANT) ----
        assert image_flags.sum().item() == IMAGE_TOKEN_LEN
        assert image_flags.shape == input_ids.shape

        return {
            "input_ids": input_ids,
            "attention_mask": attention_mask,
            "pixel_values": pixel_values,
            "image_flags": image_flags,
        }

# =============================
# BUILD SAMPLES
# =============================
samples = []
for img, rows in grouped.items():
    boxes = []
    for x1, y1, x2, y2, sw, sh in rows:
        boxes.append([
            x1 / sw,
            y1 / sh,
            x2 / sw,
            y2 / sh,
        ])
    samples.append({"image": img, "boxes": boxes})

dataset = EditTextDataset(samples)

# =============================
# COLLATE FN
# =============================
def collate_fn(batch):
    input_ids = pad_sequence(
        [b["input_ids"] for b in batch],
        batch_first=True,
        padding_value=tokenizer.pad_token_id
    )
    attention_mask = pad_sequence(
        [b["attention_mask"] for b in batch],
        batch_first=True,
        padding_value=0
    )
    image_flags = pad_sequence(
        [b["image_flags"] for b in batch],
        batch_first=True,
        padding_value=0
    )
    pixel_values = torch.stack([b["pixel_values"] for b in batch])

    # ---- FINAL ASSERTS ----
    assert image_flags.shape == input_ids.shape
    assert image_flags.sum().item() == IMAGE_TOKEN_LEN * len(batch)

    return {
        "input_ids": input_ids,
        "attention_mask": attention_mask,
        "pixel_values": pixel_values,
        "image_flags": image_flags,
    }

loader = DataLoader(
    dataset,
    batch_size=BATCH_SIZE,
    shuffle=True,
    collate_fn=collate_fn
)

# =============================
# OPTIMIZER
# =============================
optimizer = torch.optim.AdamW(
    filter(lambda p: p.requires_grad, model.parameters()),
    lr=LR
)

# =============================
# TRAIN LOOP
# =============================
for epoch in range(NUM_EPOCHS):
    for batch in loader:
        outputs = model(
            input_ids=batch["input_ids"].to(DEVICE),
            attention_mask=batch["attention_mask"].to(DEVICE),
            pixel_values=batch["pixel_values"].to(
                DEVICE, dtype=MODEL_DTYPE
            ),
            image_flags=batch["image_flags"].to(DEVICE),
            labels=batch["input_ids"].to(DEVICE),
        )

        loss = outputs.loss
        loss.backward()
        optimizer.step()
        optimizer.zero_grad()

        print("Loss:", loss.item())
