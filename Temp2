def denormalize_box(norm_box, meta, size=448):
    x1, y1, x2, y2 = [v * size for v in norm_box]

    x1 = (x1 - meta["pad_x"]) / meta["scale"]
    x2 = (x2 - meta["pad_x"]) / meta["scale"]
    y1 = (y1 - meta["pad_y"]) / meta["scale"]
    y2 = (y2 - meta["pad_y"]) / meta["scale"]

    return [
        int(max(0, min(x1, meta["orig_w"]))),
        int(max(0, min(y1, meta["orig_h"]))),
        int(max(0, min(x2, meta["orig_w"]))),
        int(max(0, min(y2, meta["orig_h"]))),
    ]







