SPECIAL_TOKENS = {
    "additional_special_tokens": ["<image>"]
}

num_added = tokenizer.add_special_tokens(SPECIAL_TOKENS)
print("Added special tokens:", num_added)

if num_added > 0:
    model.resize_token_embeddings(len(tokenizer))



image_token_id = tokenizer.convert_tokens_to_ids("<image>")
print("Image token id:", image_token_id)

assert image_token_id != tokenizer.unk_token_id
assert image_token_id is not None



assert (input_ids == image_token_id).any(), \
    "ERROR: <image> token not found in input_ids"

