Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

%labels
    Author YourName
    Description YOLO Training Environment (Ultralytics)
    Version v1.0

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1

%post
    echo "=== System setup ==="
    apt-get update && apt-get install -y \
        python3 \
        python3-pip \
        python3-dev \
        git \
        wget \
        curl \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        && rm -rf /var/lib/apt/lists/*

    echo "=== Python setup ==="
    python3 -m pip install --upgrade pip setuptools wheel

    echo "=== Install PyTorch (CUDA) ==="
    pip install torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu121

    echo "=== Install YOLO + deps ==="
    pip install ultralytics \
        opencv-python-headless \
        matplotlib \
        numpy \
        pandas \
        tqdm \
        pyyaml \
        seaborn

    echo "=== Verify installs ==="
    python3 - <<EOF
import torch, cv2
print("Torch:", torch.__version__)
print("CUDA available:", torch.cuda.is_available())
print("OpenCV:", cv2.__version__)
EOF

%runscript
    echo "YOLO container is ready."
    echo "Run commands like:"
    echo "  yolo train model=yolov8n.pt data=data.yaml epochs=100"
    exec "$@"
