from rfdetr import RFDETRBase

# Path to manually downloaded pretrained weights
checkpoint_path = "/path/to/rf-detr-base-coco.pth"

# Initialize model with checkpoint
model = RFDETRBase(
    checkpoint_path=checkpoint_path
)

# Train model
model.train(
    dataset_dir="/path/to/dataset",
    epochs=60,
    batch_size=4,
    grad_accum_steps=4,
    lr=5e-5,
    output_dir="/path/to/output"
)
