import json
import re

def parse_boxes(text):
    text = re.search(r'\[.*\]', text, re.S).group()
    data = json.loads(text)
    return [[d["x1"], d["y1"], d["x2"], d["y2"]] for d in data]


def recover_original_coords(boxes, meta):
    scale = meta["scale"]
    pad_left = meta["pad_left"]
    pad_top = meta["pad_top"]
    ow, oh = meta["orig_w"], meta["orig_h"]

    recovered = []

    for x1, y1, x2, y2 in boxes:
        # remove padding
        x1 -= pad_left
        x2 -= pad_left
        y1 -= pad_top
        y2 -= pad_top

        # rescale
        x1 /= scale
        x2 /= scale
        y1 /= scale
        y2 /= scale

        # clamp
        x1 = max(0, min(ow, x1))
        x2 = max(0, min(ow, x2))
        y1 = max(0, min(oh, y1))
        y2 = max(0, min(oh, y2))

        recovered.append([int(x1), int(y1), int(x2), int(y2)])

    return recovered




