import cv2
import numpy as np
import tensorflow as tf

def pre_process(image, input_size=(640, 640)):
    # Standard YOLOX preprocessing: Resize with padding (letterbox)
    padded_img = np.ones((input_size[0], input_size[1], 3), dtype=np.uint8) * 114
    r = min(input_size[0] / image.shape[0], input_size[1] / image.shape[1])
    resized_img = cv2.resize(
        image,
        (int(image.shape[1] * r), int(image.shape[0] * r)),
        interpolation=cv2.INTER_LINEAR,
    ).astype(np.uint8)
    padded_img[: int(image.shape[0] * r), : int(image.shape[1] * r)] = resized_img
    
    # CHW conversion and normalization
    padded_img = padded_img.transpose((2, 0, 1)) 
    padded_img = np.ascontiguousarray(padded_img, dtype=np.float32)
    padded_img /= 255.0 
    return padded_img, r

def run_inference(model_path, image_path):
    # 1. Load Model
    interpreter = tf.lite.Interpreter(model_path=model_path)
    interpreter.allocate_tensors()

    input_details = interpreter.get_input_details()
    output_details = interpreter.get_output_details()

    # 2. Prepare Image
    original_img = cv2.imread(image_path)
    input_size = (640, 640)
    input_data, ratio = pre_process(original_img, input_size)
    input_data = np.expand_dims(input_data, axis=0)

    # 3. Inference
    interpreter.set_tensor(input_details[0]['index'], input_data)
    interpreter.invoke()
    output_data = interpreter.get_tensor(output_details[0]['index'])

    # --- DEBUG PRINT: RAW OUTPUT ---
    print(f"Raw output shape: {output_data.shape}")
    # YOLOX output is typically [1, 8400, 5 + num_classes]
    # Let's check the first few rows to see if we have non-zero values
    print("First 5 raw predictions (subset):")
    print(output_data[0, :5, :]) 
    
    # 4. Filter Results (Simplified Post-process)
    # [batch, num_proposals, 5 + num_classes]
    predictions = output_data[0]
    boxes = predictions[:, :4]
    scores = predictions[:, 4] * np.max(predictions[:, 5:], axis=1)
    class_ids = np.argmax(predictions[:, 5:], axis=1)

    # Filter by a lower threshold for debugging (0.1 instead of 0.3)
    mask = scores > 0.1
    filtered_boxes = boxes[mask]
    filtered_scores = scores[mask]
    filtered_classes = class_ids[mask]

    print(f"\nDetections found above 0.1 threshold: {len(filtered_boxes)}")

    # 5. Draw and Display
    class_names = ["focused_edittext", "normal_edittext"]
    for i in range(len(filtered_boxes)):
        box = filtered_boxes[i]
        # Convert center xywh to corner x1y1x2y2
        x1 = (box[0] - box[2]/2) / ratio
        y1 = (box[1] - box[3]/2) / ratio
        x2 = (box[0] + box[2]/2) / ratio
        y2 = (box[1] + box[3]/2) / ratio
        
        print(f"Box: [{int(x1)}, {int(y1)}, {int(x2)}, {int(y2)}] | Class: {class_names[filtered_classes[i]]} | Conf: {filtered_scores[i]:.2f}")
        
        color = (0, 0, 255) if filtered_classes[i] == 0 else (0, 255, 0)
        cv2.rectangle(original_img, (int(x1), int(y1)), (int(x2), int(y2)), color, 2)

    cv2.imshow("Debug Results", original_img)
    cv2.waitKey(0)

if __name__ == "__main__":
    run_inference("model.tflite", "test.jpg")
