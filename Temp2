class EditTextDataset(Dataset):
    def __init__(self, samples, image_root, tokenizer):
        self.samples = samples          # <-- list
        self.image_root = image_root
        self.tokenizer = tokenizer

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        sample = self.samples[idx]      # ✅ FIX (no iloc)

        # -------- Image --------
        img_path = os.path.join(self.image_root, sample["image"])
        img = Image.open(img_path).convert("RGB")

        img_tensor = preprocess_image_keep_ratio(img)

        # -------- Text --------
        prompt = (
            "Identify all edit text boxes in the image. "
            "Return bounding boxes as JSON array in normalized coordinates.\n"
        )

        # STRICT JSON target
        response = json.dumps(sample["boxes"], separators=(",", ":"))

        text = prompt + response

        enc = self.tokenizer(
            text,
            return_tensors="pt",
            truncation=True,
            max_length=2048,
            padding=False
        )

        input_ids = enc["input_ids"][0]

        attention_mask = enc.get("attention_mask")
        if attention_mask is not None:
            attention_mask = attention_mask[0]

        return {
            "input_ids": input_ids,
            "attention_mask": attention_mask,
            "pixel_values": img_tensor
        }
