import csv
import os
import shutil

csv_path = "yolo_text_input.csv"
source_dir = "images_all"
dest_dir = "images_text_input"

# create destination folder if not exists
os.makedirs(dest_dir, exist_ok=True)

image_names = set()

# read csv and collect unique image names
with open(csv_path, "r", encoding="utf-8") as f:
    reader = csv.DictReader(f)
    for row in reader:
        image_names.add(row["image_name"])

copied = 0
missing = 0

for image_name in image_names:
    src_path = os.path.join(source_dir, image_name)
    dst_path = os.path.join(dest_dir, image_name)

    if not os.path.exists(src_path):
        print(f"Missing: {src_path}")
        missing += 1
        continue

    shutil.copy2(src_path, dst_path)
    copied += 1

print(f"\nDone.")
print(f"Images copied   : {copied}")
print(f"Images missing  : {missing}")
