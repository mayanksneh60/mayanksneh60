import tensorflow as tf

# path to your tflite model
tflite_model_path = "model.tflite"

# load interpreter
interpreter = tf.lite.Interpreter(model_path=tflite_model_path)
interpreter.allocate_tensors()

print("\n===== MODEL INPUT DETAILS =====")
input_details = interpreter.get_input_details()

for i, inp in enumerate(input_details):
    print(f"\nInput {i}")
    print("Name:", inp['name'])
    print("Shape:", inp['shape'])
    print("Type:", inp['dtype'])
    print("Quantization:", inp['quantization'])

print("\n===== MODEL OUTPUT DETAILS =====")
output_details = interpreter.get_output_details()

for i, out in enumerate(output_details):
    print(f"\nOutput {i}")
    print("Name:", out['name'])
    print("Shape:", out['shape'])
    print("Type:", out['dtype'])
    print("Quantization:", out['quantization'])

print("\n===== ALL TENSOR DETAILS =====")
tensor_details = interpreter.get_tensor_details()

for tensor in tensor_details:
    print("\nName:", tensor['name'])
    print("Index:", tensor['index'])
    print("Shape:", tensor['shape'])
    print("Type:", tensor['dtype'])
